#Использовать ".."

// Команды выполняются из каталога, где их запустили, а настройки и статика
// лежат рядом с пакетом, поэтому исходный каталог запоминается отдельно.
УстановитьПеременнуюСреды("ONEFLAG_CLI_START_CWD", ТекущийКаталог());
УстановитьТекущийКаталог(ОбъединитьПути(ТекущийСценарий().Каталог, ".."));

Поделка = Новый Поделка;
Поделка.ЗапуститьПриложение();


