#Использовать oneflag-sdk

&Пластилин Перем ХранилищеФлагов;
&Пластилин Перем МетрикиСервиса;

Перем Правила;

&Желудь
Процедура ПриСозданииОбъекта()

	Правила = Новый FlagEvaluator();

КонецПроцедуры

// Оценивает один флаг.
//
// Параметры:
//   Ключ                - Строка - ключ флага.
//   Окружение           - Строка - ключ окружения.
//   Контекст            - Соответствие - атрибуты пользователя, включая targetingKey.
//   ЗначениеПоУмолчанию - Произвольный - значение при внештатной ситуации.
//
// Возвращаемое значение:
//   Соответствие - поля значение, вариант, причина, кодОшибки.
//
Функция Оценить(Знач Ключ, Знач Окружение, Знач Контекст = Неопределено,
	Знач ЗначениеПоУмолчанию = Неопределено) Экспорт

	Настройка = ХранилищеФлагов.Снимок(Окружение).Получить(Ключ);
	Оценка = Правила.ОценитьПоСнимку(Ключ, Настройка, Контекст, ЗначениеПоУмолчанию);

	МетрикиСервиса.УчестьОценку(Окружение, Оценка["причина"]);

	Возврат Оценка;

КонецФункции

// Оценивает все флаги окружения разом.
//
// Параметры:
//   Окружение - Строка - ключ окружения.
//   Контекст  - Соответствие - атрибуты пользователя.
//
// Возвращаемое значение:
//   Соответствие - ключ флага -> результат оценки.
//
Функция ОценитьВсе(Знач Окружение, Знач Контекст = Неопределено) Экспорт

	Результаты = Новый Соответствие();

	Для Каждого Элемент Из ХранилищеФлагов.Снимок(Окружение) Цикл
		Оценка = Правила.ОценитьПоСнимку(Элемент.Ключ, Элемент.Значение, Контекст);
		МетрикиСервиса.УчестьОценку(Окружение, Оценка["причина"]);
		Результаты.Вставить(Элемент.Ключ, Оценка);
	КонецЦикла;

	Возврат Результаты;

КонецФункции

