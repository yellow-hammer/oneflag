&Пластилин
Перем ХранилищеФлагов;

&Пластилин
Перем Конфигурация;

&КомандаПриложения(Имя = "flags", Описание = "Список флагов окружения")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

// Показывает состояние флагов, не поднимая веб-сервер.
//
// Окружение берётся из переменной ONEFLAG_DEFAULT_ENVIRONMENT либо из
// первого аргумента команды.
//
&ВыполнениеКоманды
Процедура ПоказатьФлаги() Экспорт

	Окружение = ОкружениеИзАргументов();

	Если Не ХранилищеФлагов.ОкружениеСуществует(Окружение) Тогда
		Сообщить(СтрШаблон("Окружение %1 не найдено", Окружение));
		ЗавершитьРаботу(1);
	КонецЕсли;

	Снимок = ХранилищеФлагов.Снимок(Окружение);

	Сообщить(СтрШаблон("Окружение: %1", Окружение));
	Сообщить("");

	Если Снимок.Количество() = 0 Тогда
		Сообщить("Флагов нет.");
		Возврат;
	КонецЕсли;

	Для Каждого Элемент Из Снимок Цикл

		Настройка = Элемент.Значение;

		Сообщить(СтрШаблон("%1  %2  вариант: %3  выкатка: %4%%",
			Дополнить(Элемент.Ключ, 32),
			Дополнить(?(Настройка["включен"] = Истина, "включён", "выключен"), 10),
			Дополнить(Строка(Настройка["вариантПоУмолчанию"]), 14),
			Формат(Настройка["процентВыкатки"], "ЧГ=0; ЧН=0")));

	КонецЦикла;

КонецПроцедуры

Функция ОкружениеИзАргументов()

	Для Каждого Аргумент Из АргументыКоманднойСтроки Цикл
		Если НРег(Аргумент) <> "flags" И Не ПустаяСтрока(Аргумент) Тогда
			Возврат Аргумент;
		КонецЕсли;
	КонецЦикла;

	Возврат Конфигурация.ОкружениеПоУмолчанию();

КонецФункции

Функция Дополнить(Знач Значение, Знач Длина)

	Результат = Строка(Значение);

	Пока СтрДлина(Результат) < Длина Цикл
		Результат = Результат + " ";
	КонецЦикла;

	Возврат Результат;

КонецФункции

