#Использовать cloudevents
#Использовать ulid

&Пластилин Перем БрокерСообщенийСобытийСервера;
&Пластилин Перем ФабрикаОтветов;
&Пластилин Перем ХранилищеФлагов;
&Пластилин Перем Конфигурация;
&Пластилин Перем МетрикиСервиса;

&Лог("oneflag")
Перем Лог;

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры

// Имя SSE-топика, на который подписываются дашборд и SDK.
Функция Топик() Экспорт

	Возврат Конфигурация.ТопикПотока();

КонецФункции

// Регистрирует изменение: пишет аудит и рассылает событие подписчикам.
//
// Параметры:
//   ТипСобытия - Строка - тип в нотации CloudEvents, например com.oneflag.flag.changed.
//   Окружение  - Строка - ключ окружения.
//   КлючФлага  - Строка - ключ флага.
//   Данные     - Соответствие - полезная нагрузка события.
//   Автор      - Строка - кто внёс изменение.
//
Процедура Опубликовать(Знач ТипСобытия, Знач Окружение, Знач КлючФлага, Знач Данные, Знач Автор = "") Экспорт

	Событие = СобратьСобытие(ТипСобытия, Окружение, КлючФлага, Данные, Автор);

	ЗаписатьВАудит(Событие);
	РазослатьПодписчикам(ТипСобытия, Событие);

	МетрикиСервиса.УчестьИзменение(Окружение, ТипСобытия);

	Лог.Информация("%1: %2/%3, автор %4",
		ТипСобытия, Окружение, КлючФлага, ?(ПустаяСтрока(Автор), "не указан", Автор));

КонецПроцедуры

// Количество открытых подписок на поток изменений.
//
Функция КоличествоПодписчиков() Экспорт

	Попытка
		Возврат БрокерСообщенийСобытийСервера.КоличествоСоединений(Конфигурация.ТопикПотока());
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

////////////////////////////////////////////////////////////////////////////////

Функция СобратьСобытие(Знач ТипСобытия, Знач Окружение, Знач КлючФлага, Знач Данные, Знач Автор)

	ПолезнаяНагрузка = Новый Соответствие();
	ПолезнаяНагрузка.Вставить("окружение", Окружение);
	ПолезнаяНагрузка.Вставить("флаг", КлючФлага);
	ПолезнаяНагрузка.Вставить("автор", Автор);

	Если Данные <> Неопределено Тогда
		Для Каждого Элемент Из Данные Цикл
			ПолезнаяНагрузка.Вставить(Строка(Элемент.Ключ), Элемент.Значение);
		КонецЦикла;
	КонецЕсли;

	Событие = CloudEvents.Новое(ТипСобытия, Конфигурация.ИсточникСобытий());
	Событие.Тема(СтрШаблон("%1/%2", Окружение, КлючФлага));
	Событие.ТипДанных("application/json");
	Событие.Данные(ПолезнаяНагрузка);

	Возврат Событие;

КонецФункции

// Отказ записи не поднимается наверх: изменение флага уже применено.
//
Процедура ЗаписатьВАудит(Знач Событие)

	Попытка
		ХранилищеФлагов.ДобавитьВАудит(Событие.ВСтруктуру());
	Исключение
		Лог.Предупреждение("Событие %1 не записано в аудит: %2",
			Событие.ПолучитьИд(), КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

Процедура РазослатьПодписчикам(Знач ТипСобытия, Знач Событие)

	Попытка

		Сообщение = ФабрикаОтветов.СерверноеСобытие()
			.ТипСобытия(ТипСобытия)
			.Идентификатор(Событие.ПолучитьИд())
			.ДобавитьСтроку(Событие.ВJson());

		БрокерСообщенийСобытийСервера.ОтправитьСообщениеВсем(Конфигурация.ТопикПотока(), Сообщение);

	Исключение
		// Обрыв подписчика - обычное дело, брокер сам вычистит соединение,
		// поэтому уровень отладочный: в проде такие строки не нужны
		Лог.Отладка("Рассылка события %1 прервана: %2",
			ТипСобытия, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры
