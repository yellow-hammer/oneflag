// winow маршрутизирует только по пути, поэтому метод запроса проверяется вручную.

#Использовать problem-details

&Пластилин Перем ХранилищеФлагов;
&Пластилин Перем СервисСобытий;
&Пластилин Перем СервисБезопасности;
&Пластилин Перем Конфигурация;

&Контроллер("/api")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ТочкаМаршрута("flags")
&НеВыводитОтображениеКонтроллера
Процедура Флаги(Запрос, Ответ) Экспорт

	Если Не Авторизован(Запрос, Ответ) Тогда
		Возврат;
	КонецЕсли;

	Если Запрос.Метод = "GET" Тогда
		ВернутьСписок(Запрос, Ответ);
	ИначеЕсли Запрос.Метод = "POST" Тогда
		СоздатьФлаг(Запрос, Ответ);
	Иначе
		ВернутьПроблему(Ответ, 405, "Метод не поддерживается");
	КонецЕсли;

КонецПроцедуры

&ТочкаМаршрута("flags/{ключ}")
&НеВыводитОтображениеКонтроллера
Процедура Флаг(Запрос, Ответ, ключ) Экспорт

	Если Не Авторизован(Запрос, Ответ) Тогда
		Возврат;
	КонецЕсли;

	Если Запрос.Метод = "GET" Тогда
		ВернутьФлаг(Ответ, ключ);
	ИначеЕсли Запрос.Метод = "PATCH" Или Запрос.Метод = "PUT" Тогда
		ИзменитьНастройку(Запрос, Ответ, ключ);
	ИначеЕсли Запрос.Метод = "DELETE" Тогда
		УдалитьФлаг(Запрос, Ответ, ключ);
	Иначе
		ВернутьПроблему(Ответ, 405, "Метод не поддерживается");
	КонецЕсли;

КонецПроцедуры

&ТочкаМаршрута("environments")
&НеВыводитОтображениеКонтроллера
Процедура Окружения(Запрос, Ответ) Экспорт

	Если Не Авторизован(Запрос, Ответ) Тогда
		Возврат;
	КонецЕсли;

	ВернутьJson(Ответ, 200, ХранилищеФлагов.Окружения());

КонецПроцедуры

&ТочкаМаршрута("audit")
&НеВыводитОтображениеКонтроллера
Процедура Аудит(Запрос, Ответ) Экспорт

	Если Не Авторизован(Запрос, Ответ) Тогда
		Возврат;
	КонецЕсли;

	ВернутьJson(Ответ, 200, ХранилищеФлагов.Аудит(Число(ПараметрЗапроса(Запрос, "limit", "50"))));

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////

Процедура ВернутьСписок(Запрос, Ответ)

	Окружение = ОкружениеЗапроса(Запрос);

	Если Не ХранилищеФлагов.ОкружениеСуществует(Окружение) Тогда
		ВернутьПроблему(Ответ, 404, СтрШаблон("Окружение %1 не найдено", Окружение));
		Возврат;
	КонецЕсли;

	Результат = Новый Массив();
	Снимок = ХранилищеФлагов.Снимок(Окружение);

	Для Каждого Описание Из ХранилищеФлагов.Флаги() Цикл

		СтрокаСписка = Новый Соответствие();
		СтрокаСписка.Вставить("ключ", Описание["ключ"]);
		СтрокаСписка.Вставить("имя", Описание["имя"]);
		СтрокаСписка.Вставить("описание", Описание["описание"]);
		СтрокаСписка.Вставить("тип", Описание["тип"]);
		СтрокаСписка.Вставить("варианты", Описание["варианты"]);
		СтрокаСписка.Вставить("настройка", Снимок.Получить(Описание["ключ"]));

		Результат.Добавить(СтрокаСписка);

	КонецЦикла;

	Тело = Новый Соответствие();
	Тело.Вставить("окружение", Окружение);
	Тело.Вставить("флаги", Результат);

	ВернутьJson(Ответ, 200, Тело);

КонецПроцедуры

Процедура ВернутьФлаг(Ответ, Знач Ключ)

	Описание = ХранилищеФлагов.Флаг(Ключ);

	Если Описание = Неопределено Тогда
		ВернутьПроблему(Ответ, 404, СтрШаблон("Флаг %1 не найден", Ключ));
		Возврат;
	КонецЕсли;

	ВернутьJson(Ответ, 200, Описание);

КонецПроцедуры

Процедура СоздатьФлаг(Запрос, Ответ)

	Тело = ТелоЗапроса(Запрос);

	Если Тело = Неопределено Тогда
		ВернутьПроблему(Ответ, 400, "Тело запроса должно быть объектом JSON");
		Возврат;
	КонецЕсли;

	Попытка
		Созданный = ХранилищеФлагов.СоздатьФлаг(Тело);
	Исключение
		ВернутьПроблему(Ответ, 400, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Данные = Новый Соответствие();
	Данные.Вставить("тип", Созданный["тип"]);

	СервисСобытий.Опубликовать("com.oneflag.flag.created", ОкружениеЗапроса(Запрос),
		Созданный["ключ"], Данные, ПользовательЗапроса(Запрос));

	ВернутьJson(Ответ, 201, Созданный);

КонецПроцедуры

Процедура ИзменитьНастройку(Запрос, Ответ, Знач Ключ)

	Тело = ТелоЗапроса(Запрос);

	Если Тело = Неопределено Тогда
		ВернутьПроблему(Ответ, 400, "Тело запроса должно быть объектом JSON");
		Возврат;
	КонецЕсли;

	Окружение = ОкружениеЗапроса(Запрос);

	Попытка
		Обновлённый = ХранилищеФлагов.ОбновитьНастройку(Ключ, Окружение, Тело);
	Исключение
		ВернутьПроблему(Ответ, 400, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Настройка = ХранилищеФлагов.Снимок(Окружение).Получить(Ключ);

	Данные = Новый Соответствие();
	Данные.Вставить("включен", Настройка["включен"]);
	Данные.Вставить("вариантПоУмолчанию", Настройка["вариантПоУмолчанию"]);
	Данные.Вставить("процентВыкатки", Настройка["процентВыкатки"]);

	СервисСобытий.Опубликовать("com.oneflag.flag.changed", Окружение, Ключ, Данные,
		ПользовательЗапроса(Запрос));

	ВернутьJson(Ответ, 200, Обновлённый);

КонецПроцедуры

Процедура УдалитьФлаг(Запрос, Ответ, Знач Ключ)

	Если Не ХранилищеФлагов.УдалитьФлаг(Ключ) Тогда
		ВернутьПроблему(Ответ, 404, СтрШаблон("Флаг %1 не найден", Ключ));
		Возврат;
	КонецЕсли;

	СервисСобытий.Опубликовать("com.oneflag.flag.deleted", ОкружениеЗапроса(Запрос), Ключ,
		Новый Соответствие(), ПользовательЗапроса(Запрос));

	Ответ.УстановитьСостояние(204);
	Ответ.ТелоТекст = "";

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////

Функция Авторизован(Запрос, Ответ)

	Проверка = СервисБезопасности.ПроверитьТокен(СервисБезопасности.ТокенЗапроса(Запрос));

	Если Проверка["валиден"] Тогда
		Возврат Истина;
	КонецЕсли;

	Если СервисБезопасности.КлючSDKВерен(Запрос.Заголовки) Тогда
		Возврат Истина;
	КонецЕсли;

	ВернутьПроблему(Ответ, 401, "Требуется вход в дашборд или ключ SDK");

	Возврат Ложь;

КонецФункции

Функция ПользовательЗапроса(Запрос)

	Проверка = СервисБезопасности.ПроверитьТокен(СервисБезопасности.ТокенЗапроса(Запрос));

	Возврат ?(Проверка["валиден"], Проверка["пользователь"], "sdk");

КонецФункции

Функция ОкружениеЗапроса(Запрос)

	Возврат ПараметрЗапроса(Запрос, "env", Конфигурация.ОкружениеПоУмолчанию());

КонецФункции

Функция ПараметрЗапроса(Запрос, Знач Имя, Знач ЗначениеПоУмолчанию)

	Параметры = Запрос.ПараметрыИменные;

	Если Параметры = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Значение = Параметры.Получить(Имя);

	Возврат ?(Значение = Неопределено Или ПустаяСтрока(Строка(Значение)), ЗначениеПоУмолчанию, Строка(Значение));

КонецФункции

Функция ТелоЗапроса(Запрос)

	Если ПустаяСтрока(Запрос.Тело) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Запрос.Тело);

	Попытка
		Результат = ПрочитатьJSON(Чтение, Истина);
	Исключение
		Чтение.Закрыть();
		Возврат Неопределено;
	КонецПопытки;

	Чтение.Закрыть();

	Возврат ?(ТипЗнч(Результат) = Тип("Соответствие"), Результат, Неопределено);

КонецФункции

Процедура ВернутьJson(Ответ, Знач Код, Знач Значение)

	Ответ.УстановитьСостояние(Код);
	Ответ.Заголовки["Content-Type"] = "application/json; charset=utf-8";
	Ответ.ТелоТекст = ВТекстJson(Значение);

КонецПроцедуры

Процедура ВернутьПроблему(Ответ, Знач Код, Знач Детали)

	Сформированный = ProblemResponse.ПоСтатусу(Код, Детали);

	Ответ.УстановитьСостояние(Код);
	Ответ.Заголовки["Content-Type"] = HttpProblems.ТипСодержимого();
	Ответ.ТелоТекст = Сформированный.Тело;

КонецПроцедуры

Функция ВТекстJson(Знач Значение)

	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, Значение);

	Возврат Запись.Закрыть();

КонецФункции



