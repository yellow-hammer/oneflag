#Использовать entity

&Пластилин Перем Конфигурация;

&Лог("oneflag")
Перем Лог;

Перем МенеджерСущностей;
Перем ХранилищеФлаговБД;
Перем ХранилищеОкружений;
Перем ХранилищеНастроек;
Перем ХранилищеАудита;

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры

// Подключается к СУБД и создаёт схему при первом обращении: со стартовым хуком
// подключение зависело бы от порядка подъёма компонентов autumn.
//
Процедура УбедитьсяЧтоГотово() Экспорт

	Если МенеджерСущностей <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	МенеджерСущностей = Новый МенеджерСущностей(ТипКоннектора(), СтрокаСоединения());

	МенеджерСущностей.ДобавитьКлассВМодель(Тип("FeatureFlag"));
	МенеджерСущностей.ДобавитьКлассВМодель(Тип("FlagEnvironment"));
	МенеджерСущностей.ДобавитьКлассВМодель(Тип("FlagSetting"));
	МенеджерСущностей.ДобавитьКлассВМодель(Тип("FlagAuditRecord"));

	МенеджерСущностей.Инициализировать();

	ХранилищеФлаговБД = МенеджерСущностей.ПолучитьХранилищеСущностей(Тип("FeatureFlag"));
	ХранилищеОкружений = МенеджерСущностей.ПолучитьХранилищеСущностей(Тип("FlagEnvironment"));
	ХранилищеНастроек = МенеджерСущностей.ПолучитьХранилищеСущностей(Тип("FlagSetting"));
	ХранилищеАудита = МенеджерСущностей.ПолучитьХранилищеСущностей(Тип("FlagAuditRecord"));

	ОбеспечитьОкружения();

	// Строку соединения не пишем: у postgresql в ней пароль
	Лог.Информация("Хранилище готово: вид %1", Конфигурация.ВидХранилища());

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Чтение

// Все флаги.
//
// Возвращаемое значение:
//   Массив из Соответствие - описания флагов.
//
Функция Флаги() Экспорт

	УбедитьсяЧтоГотово();

	Результат = Новый Массив();

	Для Каждого Запись Из ХранилищеФлаговБД.Получить() Цикл
		Результат.Добавить(ОписаниеФлага(Запись));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Параметры:
//   Ключ - Строка - ключ флага.
//
// Возвращаемое значение:
//   Соответствие - описание флага либо Неопределено.
//
Функция Флаг(Знач Ключ) Экспорт

	УбедитьсяЧтоГотово();

	Запись = ХранилищеФлаговБД.ПолучитьОдно(Строка(Ключ));

	Возврат ?(Запись = Неопределено, Неопределено, ОписаниеФлага(Запись));

КонецФункции

// Возвращаемое значение:
//   Массив из Соответствие - описания окружений.
//
Функция Окружения() Экспорт

	УбедитьсяЧтоГотово();

	Результат = Новый Массив();

	Для Каждого Запись Из ХранилищеОкружений.Получить(ОпцииПоПорядку()) Цикл
		Окружение = Новый Соответствие();
		Окружение.Вставить("ключ", Запись.Ключ);
		Окружение.Вставить("имя", Запись.Имя);
		Результат.Добавить(Окружение);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Параметры:
//   Ключ - Строка - ключ окружения.
//
// Возвращаемое значение:
//   Булево - Истина, если окружение существует.
//
Функция ОкружениеСуществует(Знач Ключ) Экспорт

	УбедитьсяЧтоГотово();

	Возврат ХранилищеОкружений.ПолучитьОдно(Строка(Ключ)) <> Неопределено;

КонецФункции

// Снимок всех флагов окружения. Его забирают SDK-клиенты при подключении.
//
// Параметры:
//   Окружение - Строка - ключ окружения.
//
// Возвращаемое значение:
//   Соответствие - ключ флага -> настройка в этом окружении.
//
Функция Снимок(Знач Окружение) Экспорт

	УбедитьсяЧтоГотово();

	Результат = Новый Соответствие();

	Для Каждого Флаг Из ХранилищеФлаговБД.Получить() Цикл

		Настройка = НайтиНастройку(Флаг.Ключ, Окружение);

		Если Настройка = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Результат.Вставить(Флаг.Ключ, СнимокФлага(Флаг, Настройка));

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Параметры:
//   Предел - Число - максимальное количество записей.
//
// Возвращаемое значение:
//   Массив - события журнала, свежие первыми.
//
Функция Аудит(Знач Предел = 50) Экспорт

	УбедитьсяЧтоГотово();

	Опции = Новый ОпцииПоиска()
		.СортироватьПо("Ключ", НаправлениеСортировки.Убыв)
		.Первые(Предел);

	Результат = Новый Массив();

	// Идентификатор записи - ULID, он монотонно растёт вместе со временем,
	// поэтому сортировки по нему достаточно и отдельный индекс по дате не нужен
	Для Каждого Запись Из ХранилищеАудита.Получить(Опции) Цикл
		Результат.Добавить(ИзJson(Запись.СобытиеJson));
	КонецЦикла;

	Возврат Результат;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Изменение

// Создаёт флаг и его настройки во всех окружениях.
//
// Параметры:
//   Описание - Структура, Соответствие - поля ключ, имя, описание, тип, варианты.
//
// Возвращаемое значение:
//   Соответствие - созданный флаг.
//
Функция СоздатьФлаг(Знач Описание) Экспорт

	УбедитьсяЧтоГотово();

	Ключ = СокрЛП(Строка(Поле(Описание, "ключ", "")));

	Если ПустаяСтрока(Ключ) Тогда
		ВызватьИсключение "Не задан ключ флага";
	КонецЕсли;

	Если Не КлючКорректен(Ключ) Тогда
		ВызватьИсключение "Ключ флага может содержать латинские буквы, цифры, дефис, подчёркивание и точку";
	КонецЕсли;

	Если ХранилищеФлаговБД.ПолучитьОдно(Ключ) <> Неопределено Тогда
		ВызватьИсключение СтрШаблон("Флаг %1 уже существует", Ключ);
	КонецЕсли;

	ТипФлага = ТипЗначенияФлага(Поле(Описание, "тип", "boolean"));
	Варианты = ВариантыФлага(Описание, ТипФлага);
	Метка = ТекущаяМетка();

	Запись = ХранилищеФлаговБД.СоздатьЭлемент();
	Запись.Ключ = Ключ;
	Запись.Имя = Строка(Поле(Описание, "имя", Ключ));
	Запись.Описание = Строка(Поле(Описание, "описание", ""));
	Запись.ТипЗначения = ТипФлага;
	Запись.ВариантыJson = ВJson(Варианты);
	Запись.Создан = Метка;
	Запись.Изменён = Метка;

	ХранилищеФлаговБД.Сохранить(Запись);

	Для Каждого Окружение Из Окружения() Цикл
		СоздатьНастройку(Ключ, Окружение["ключ"], ПервыйВариант(Варианты));
	КонецЦикла;

	Возврат ОписаниеФлага(Запись);

КонецФункции

// Обновляет настройку флага в окружении.
//
// Параметры:
//   Ключ      - Строка - ключ флага.
//   Окружение - Строка - ключ окружения.
//   Изменения - Структура, Соответствие - поля включен, вариантПоУмолчанию,
//                                         процентВыкатки, правила.
//
// Возвращаемое значение:
//   Соответствие - обновлённый флаг.
//
Функция ОбновитьНастройку(Знач Ключ, Знач Окружение, Знач Изменения) Экспорт

	УбедитьсяЧтоГотово();

	Флаг = ХранилищеФлаговБД.ПолучитьОдно(Строка(Ключ));

	Если Флаг = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Флаг %1 не найден", Ключ);
	КонецЕсли;

	Если Не ОкружениеСуществует(Окружение) Тогда
		ВызватьИсключение СтрШаблон("Окружение %1 не найдено", Окружение);
	КонецЕсли;

	Варианты = ИзJson(Флаг.ВариантыJson);
	Настройка = НайтиНастройку(Ключ, Окружение);

	Если Настройка = Неопределено Тогда
		Настройка = СоздатьНастройку(Ключ, Окружение, ПервыйВариант(Варианты));
	КонецЕсли;

	ПрименитьИзменения(Настройка, Варианты, Ключ, Изменения);

	Флаг.Изменён = ТекущаяМетка();

	ХранилищеНастроек.Сохранить(Настройка);
	ХранилищеФлаговБД.Сохранить(Флаг);

	Возврат ОписаниеФлага(Флаг);

КонецФункции

// Удаляет флаг вместе с его настройками во всех окружениях.
//
// Параметры:
//   Ключ - Строка - ключ флага.
//
// Возвращаемое значение:
//   Булево - Истина, если флаг был найден и удалён.
//
Функция УдалитьФлаг(Знач Ключ) Экспорт

	УбедитьсяЧтоГотово();

	Флаг = ХранилищеФлаговБД.ПолучитьОдно(Строка(Ключ));

	Если Флаг = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Отбор = Новый Соответствие();
	Отбор.Вставить("КлючФлага", Строка(Ключ));

	Для Каждого Настройка Из ХранилищеНастроек.Получить(Отбор) Цикл
		ХранилищеНастроек.Удалить(Настройка);
	КонецЦикла;

	ХранилищеФлаговБД.Удалить(Флаг);

	Возврат Истина;

КонецФункции

// Добавляет событие в журнал изменений.
//
// Параметры:
//   Запись - Структура, Соответствие - событие в формате CloudEvents.
//
Процедура ДобавитьВАудит(Знач Запись) Экспорт

	УбедитьсяЧтоГотово();

	Данные = Поле(Запись, "data", Новый Соответствие());

	Событие = ХранилищеАудита.СоздатьЭлемент();
	Событие.Ключ = Строка(Поле(Запись, "id", ""));
	Событие.Время = Строка(Поле(Запись, "time", ""));
	Событие.ТипСобытия = Строка(Поле(Запись, "type", ""));
	Событие.КлючОкружения = Строка(Поле(Данные, "окружение", ""));
	Событие.КлючФлага = Строка(Поле(Данные, "флаг", ""));
	Событие.Автор = Строка(Поле(Данные, "автор", ""));
	Событие.СобытиеJson = ВJson(Запись);

	ХранилищеАудита.Сохранить(Событие);

	ВытеснитьСтарыеЗаписи();

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Настройка подключения

Функция ТипКоннектора()

	Вид = НРег(СокрЛП(Конфигурация.ВидХранилища()));

	Если Вид = "sqlite" Тогда
		Возврат Тип("КоннекторSQLite");
	ИначеЕсли Вид = "postgresql" Тогда
		Возврат Тип("КоннекторPostgreSQL");
	ИначеЕсли Вид = "json" Тогда
		Возврат Тип("КоннекторJSON");
	ИначеЕсли Вид = "memory" Тогда
		Возврат Тип("КоннекторInMemory");
	КонецЕсли;

	ВызватьИсключение СтрШаблон(
		"Неизвестный вид хранилища: %1. Допустимые: sqlite, postgresql, json, memory", Вид);

КонецФункции

Функция СтрокаСоединения()

	Вид = НРег(СокрЛП(Конфигурация.ВидХранилища()));
	Значение = Конфигурация.СтрокаСоединения();

	Если Вид = "sqlite" Тогда
		ОбеспечитьКаталогФайла(Значение);
		Возврат СтрШаблон("Data Source=%1", Значение);
	КонецЕсли;

	Если Вид = "json" Тогда
		// Коннектор JSON не создаёт каталог сам и падает при его отсутствии
		СоздатьКаталог(Значение);
	КонецЕсли;

	Возврат Значение;

КонецФункции

Процедура ОбеспечитьКаталогФайла(Знач ПутьКФайлу)

	Каталог = Новый Файл(ПутьКФайлу).Путь;

	Если Не ПустаяСтрока(Каталог) Тогда
		СоздатьКаталог(Каталог);
	КонецЕсли;

КонецПроцедуры

// Окружения задаются настройкой сервиса, поэтому при старте список в базе
// приводится к настройке: новые добавляются, уже существующие не трогаем.
//
Процедура ОбеспечитьОкружения()

	Порядок = 0;

	Для Каждого Ключ Из Конфигурация.Окружения() Цикл

		Порядок = Порядок + 1;

		Если ХранилищеОкружений.ПолучитьОдно(Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Запись = ХранилищеОкружений.СоздатьЭлемент();
		Запись.Ключ = Ключ;
		Запись.Имя = Ключ;
		Запись.Порядок = Порядок;

		ХранилищеОкружений.Сохранить(Запись);

	КонецЦикла;

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Работа с настройками

Функция НайтиНастройку(Знач КлючФлага, Знач Окружение)

	Возврат ХранилищеНастроек.ПолучитьОдно(КлючНастройки(КлючФлага, Окружение));

КонецФункции

Функция СоздатьНастройку(Знач КлючФлага, Знач Окружение, Знач ВариантПоУмолчанию)

	Запись = ХранилищеНастроек.СоздатьЭлемент();
	Запись.Ключ = КлючНастройки(КлючФлага, Окружение);
	Запись.КлючФлага = КлючФлага;
	Запись.КлючОкружения = Окружение;
	Запись.Включен = Ложь;
	Запись.ВариантПоУмолчанию = ВариантПоУмолчанию;
	Запись.ПроцентВыкатки = 100;
	Запись.ПравилаJson = "[]";

	ХранилищеНастроек.Сохранить(Запись);

	Возврат Запись;

КонецФункции

Функция КлючНастройки(Знач КлючФлага, Знач Окружение)

	Возврат СтрШаблон("%1:%2", Окружение, КлючФлага);

КонецФункции

Процедура ПрименитьИзменения(Настройка, Знач Варианты, Знач КлючФлага, Знач Изменения)

	Включен = Поле(Изменения, "включен");
	Если Включен <> Неопределено Тогда
		Настройка.Включен = (Включен = Истина Или Строка(Включен) = "true");
	КонецЕсли;

	Вариант = Поле(Изменения, "вариантПоУмолчанию");
	Если Вариант <> Неопределено Тогда
		Если Варианты.Получить(Строка(Вариант)) = Неопределено Тогда
			ВызватьИсключение СтрШаблон("Вариант %1 не описан у флага %2", Вариант, КлючФлага);
		КонецЕсли;
		Настройка.ВариантПоУмолчанию = Строка(Вариант);
	КонецЕсли;

	Процент = Поле(Изменения, "процентВыкатки");
	Если Процент <> Неопределено Тогда
		ЧисловойПроцент = Число(Процент);
		Если ЧисловойПроцент < 0 Или ЧисловойПроцент > 100 Тогда
			ВызватьИсключение "Процент выкатки должен быть в диапазоне от 0 до 100";
		КонецЕсли;
		Настройка.ПроцентВыкатки = ЧисловойПроцент;
	КонецЕсли;

	Правила = Поле(Изменения, "правила");
	Если Правила <> Неопределено Тогда
		Настройка.ПравилаJson = ВJson(ПроверитьПравила(Варианты, КлючФлага, Правила));
	КонецЕсли;

КонецПроцедуры

Функция ПроверитьПравила(Знач Варианты, Знач КлючФлага, Знач Правила)

	Результат = Новый Массив();

	Для Каждого Правило Из Правила Цикл

		Атрибут = СокрЛП(Строка(Поле(Правило, "атрибут", "")));
		Вариант = Строка(Поле(Правило, "вариант", ""));

		Если ПустаяСтрока(Атрибут) Тогда
			ВызватьИсключение "В правиле таргетинга не задан атрибут";
		КонецЕсли;

		Если Варианты.Получить(Вариант) = Неопределено Тогда
			ВызватьИсключение СтрШаблон("Вариант %1 не описан у флага %2", Вариант, КлючФлага);
		КонецЕсли;

		Нормализованное = Новый Соответствие();
		Нормализованное.Вставить("атрибут", Атрибут);
		Нормализованное.Вставить("оператор", ОператорПравила(Поле(Правило, "оператор", "равно")));
		Нормализованное.Вставить("значения", ЗначенияПравила(Поле(Правило, "значения")));
		Нормализованное.Вставить("вариант", Вариант);

		Результат.Добавить(Нормализованное);

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ОператорПравила(Знач Значение)

	Оператор = НРег(СокрЛП(Строка(Значение)));
	Допустимые = "равно,не равно,содержит,начинается с,заканчивается на,больше,меньше,"
		+ "версия равна,версия больше,версия меньше,версия в диапазоне";

	Если СтрНайти("," + Допустимые + ",", "," + Оператор + ",") = 0 Тогда
		ВызватьИсключение СтрШаблон("Неизвестный оператор правила: %1. Допустимые: %2", Значение, Допустимые);
	КонецЕсли;

	Возврат Оператор;

КонецФункции

Функция ЗначенияПравила(Знач Значения)

	Результат = Новый Массив();

	Если Значения = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Если ТипЗнч(Значения) = Тип("Массив") Тогда
		Для Каждого Значение Из Значения Цикл
			Результат.Добавить(Строка(Значение));
		КонецЦикла;
	Иначе
		Для Каждого Значение Из СтрРазделить(Строка(Значения), ",", Ложь) Цикл
			Результат.Добавить(СокрЛП(Значение));
		КонецЦикла;
	КонецЕсли;

	Возврат Результат;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Преобразование сущностей в прикладные структуры

Функция ОписаниеФлага(Знач Запись)

	Настройки = Новый Соответствие();

	Отбор = Новый Соответствие();
	Отбор.Вставить("КлючФлага", Запись.Ключ);

	Для Каждого Настройка Из ХранилищеНастроек.Получить(Отбор) Цикл
		Настройки.Вставить(Настройка.КлючОкружения, ОписаниеНастройки(Настройка));
	КонецЦикла;

	Результат = Новый Соответствие();
	Результат.Вставить("ключ", Запись.Ключ);
	Результат.Вставить("имя", Запись.Имя);
	Результат.Вставить("описание", Запись.Описание);
	Результат.Вставить("тип", Запись.ТипЗначения);
	Результат.Вставить("варианты", ИзJson(Запись.ВариантыJson));
	Результат.Вставить("создан", Запись.Создан);
	Результат.Вставить("изменён", Запись.Изменён);
	Результат.Вставить("настройки", Настройки);

	Возврат Результат;

КонецФункции

Функция ОписаниеНастройки(Знач Настройка)

	Результат = Новый Соответствие();
	Результат.Вставить("включен", Настройка.Включен = Истина);
	Результат.Вставить("вариантПоУмолчанию", Настройка.ВариантПоУмолчанию);
	Результат.Вставить("процентВыкатки", Настройка.ПроцентВыкатки);
	Результат.Вставить("правила", ИзJson(Настройка.ПравилаJson));

	Возврат Результат;

КонецФункции

Функция СнимокФлага(Знач Флаг, Знач Настройка)

	Результат = Новый Соответствие();
	Результат.Вставить("ключ", Флаг.Ключ);
	Результат.Вставить("тип", Флаг.ТипЗначения);
	Результат.Вставить("варианты", ИзJson(Флаг.ВариантыJson));
	Результат.Вставить("включен", Настройка.Включен = Истина);
	Результат.Вставить("вариантПоУмолчанию", Настройка.ВариантПоУмолчанию);
	Результат.Вставить("процентВыкатки", Настройка.ПроцентВыкатки);
	Результат.Вставить("правила", ИзJson(Настройка.ПравилаJson));

	Возврат Результат;

КонецФункции

Функция ВариантыФлага(Знач Описание, Знач ТипФлага)

	Заданные = Поле(Описание, "варианты");

	Если Заданные <> Неопределено И Заданные.Количество() > 0 Тогда

		Результат = Новый Соответствие();

		Для Каждого Элемент Из Заданные Цикл
			Результат.Вставить(Строка(Элемент.Ключ), Элемент.Значение);
		КонецЦикла;

		Возврат Результат;

	КонецЕсли;

	Результат = Новый Соответствие();

	Если ТипФлага = "boolean" Тогда
		Результат.Вставить("вкл", Истина);
		Результат.Вставить("выкл", Ложь);
	ИначеЕсли ТипФлага = "number" Тогда
		Результат.Вставить("значение", 0);
	ИначеЕсли ТипФлага = "object" Тогда
		Результат.Вставить("значение", Новый Соответствие());
	Иначе
		Результат.Вставить("значение", "");
	КонецЕсли;

	Возврат Результат;

КонецФункции

Процедура ВытеснитьСтарыеЗаписи()

	Предел = Конфигурация.ПределАудита();
	Всего = ХранилищеАудита.Получить().Количество();

	Если Всего <= Предел Тогда
		Возврат;
	КонецЕсли;

	Опции = Новый ОпцииПоиска()
		.СортироватьПо("Ключ", НаправлениеСортировки.Возр)
		.Первые(Всего - Предел);

	Для Каждого Запись Из ХранилищеАудита.Получить(Опции) Цикл
		ХранилищеАудита.Удалить(Запись);
	КонецЦикла;

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Вспомогательные

Функция ОпцииПоПорядку()

	Возврат Новый ОпцииПоиска().СортироватьПо("Порядок", НаправлениеСортировки.Возр);

КонецФункции

Функция ПервыйВариант(Знач Варианты)

	Для Каждого Элемент Из Варианты Цикл
		Возврат Элемент.Ключ;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция ТипЗначенияФлага(Знач Значение)

	ТипФлага = НРег(СокрЛП(Строка(Значение)));

	Если СтрНайти(",boolean,string,number,object,", "," + ТипФлага + ",") = 0 Тогда
		ВызватьИсключение СтрШаблон(
			"Неизвестный тип флага: %1. Допустимые: boolean, string, number, object", Значение);
	КонецЕсли;

	Возврат ТипФлага;

КонецФункции

Функция КлючКорректен(Знач Ключ)

	Для Позиция = 1 По СтрДлина(Ключ) Цикл

		Код = КодСимвола(Ключ, Позиция);
		Символ = Сред(Ключ, Позиция, 1);

		Буква = (Код >= 97 И Код <= 122) Или (Код >= 65 И Код <= 90);
		Цифра = Код >= 48 И Код <= 57;
		Разделитель = Символ = "-" Или Символ = "_" Или Символ = ".";

		Если Не (Буква Или Цифра Или Разделитель) Тогда
			Возврат Ложь;
		КонецЕсли;

	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция ТекущаяМетка()

	Возврат Формат(ТекущаяУниверсальнаяДата(), "ДФ=yyyy-MM-ddTHH:mm:ss") + "Z";

КонецФункции

Функция Поле(Знач Источник, Знач Имя, Знач ЗначениеПоУмолчанию = Неопределено)

	Если Источник = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Если ТипЗнч(Источник) = Тип("Соответствие") Тогда
		Найденное = Источник.Получить(Имя);
		Возврат ?(Найденное = Неопределено, ЗначениеПоУмолчанию, Найденное);
	КонецЕсли;

	Найденное = Неопределено;

	Если Источник.Свойство(Имя, Найденное) И Найденное <> Неопределено Тогда
		Возврат Найденное;
	КонецЕсли;

	Возврат ЗначениеПоУмолчанию;

КонецФункции

Функция ВJson(Знач Значение)

	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, Значение);

	Возврат Запись.Закрыть();

КонецФункции

Функция ИзJson(Знач Текст)

	Если ПустаяСтрока(Текст) Тогда
		Возврат Новый Соответствие();
	КонецЕсли;

	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Текст);

	Попытка
		Результат = ПрочитатьJSON(Чтение, Истина);
	Исключение
		Чтение.Закрыть();
		Возврат Новый Соответствие();
	КонецПопытки;

	Чтение.Закрыть();

	Возврат Результат;

КонецФункции

