# Порт HTTP-сервера
ONEFLAG_PORT=3333

# Хранилище: sqlite, postgresql, json или memory
ONEFLAG_STORAGE_KIND=sqlite

# Строка соединения. Для sqlite - путь к файлу базы, для json - каталог,
# для postgresql - полная строка соединения, для memory - произвольная метка.
ONEFLAG_STORAGE=data/oneflag.db

# Секрет подписи токенов. В продакшене задайте своё длинное случайное значение.
ONEFLAG_SECRET=измените-этот-секрет-в-продакшене

# Учётные данные администратора дашборда
ONEFLAG_ADMIN_LOGIN=admin
ONEFLAG_ADMIN_PASSWORD=admin

# Ключ, по которому SDK читают флаги
ONEFLAG_SDK_KEY=local-sdk-key

# Окружения и то, которое открывается по умолчанию
ONEFLAG_ENVIRONMENTS=dev,stage,prod
ONEFLAG_DEFAULT_ENVIRONMENT=dev

# Сколько записей аудита хранить
ONEFLAG_AUDIT_LIMIT=500

# Источник событий CloudEvents
ONEFLAG_EVENT_SOURCE=/oneflag
