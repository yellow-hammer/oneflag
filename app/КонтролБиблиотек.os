// Маппингом каталога файлы отдать нельзя: путь к статике пакета известен только
// в рантайме, а winow читает каталоги из настроек до старта прикладного кода.

#Использовать winow-view

&Контроллер("/")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ТочкаМаршрута("vendor/{имяБиблиотеки}")
&НеВыводитОтображениеКонтроллера
Процедура Библиотека(Запрос, Ответ, имяБиблиотеки) Экспорт

	Попытка
		// Имя приходит из запроса, но winow-view сверяет его с закрытым списком
		// и прочитать через маршрут произвольный файл на диске нельзя
		Содержимое = View.СодержимоеБиблиотеки(имяБиблиотеки);
	Исключение
		Ответ.УстановитьСостояние(404);
		Ответ.Заголовки["Content-Type"] = "text/plain; charset=utf-8";
		Ответ.ТелоТекст = "Библиотека не найдена";
		Возврат;
	КонецПопытки;

	Ответ.УстановитьСостояние(200);
	Ответ.Заголовки["Content-Type"] = "application/javascript; charset=utf-8";
	// Содержимое меняется только вместе с пакетом winow-view
	Ответ.Заголовки["Cache-Control"] = "public, max-age=86400";
	Ответ.ТелоТекст = Содержимое;

КонецПроцедуры
