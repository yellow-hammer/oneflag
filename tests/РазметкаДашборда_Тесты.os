#Использовать asserts
#Использовать winow-view
#Использовать ".."

// Разметка собирается шаблонами JinjOS, поэтому проверяется главное, что легко
// сломать правкой шаблона: экранирование данных и попадание значений в атрибуты
// htmx, по которым дашборд ходит на сервер.

////////////////////////////////////////////////////////////////////////////////
// Страница

&Тест
&ОтображаемоеИмя("Страница собирается с макетом и подключает скрипты")
Процедура СтраницаСобираетсяСМакетом() Экспорт

	Разметка = Разметка().Страница("dev", Окружения(), Флаги(), "admin");

	Ожидаем.Что(СтрНачинаетсяС(Разметка, "<!DOCTYPE html>")).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, "/vendor/htmx.min.js")).Больше(0);
	Ожидаем.Что(СтрНайти(Разметка, "/static/oneflag.js")).Больше(0);
	Ожидаем.Что(СтрНайти(Разметка, "</html>")).Больше(0);

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Выбранное окружение помечено активным и попадает в атрибут тела")
Процедура ВыбранноеОкружениеПомечено() Экспорт

	Разметка = Разметка().Страница("prod", Окружения(), Флаги(), "admin");

	Ожидаем.Что(СтрНайти(Разметка, "data-окружение=""prod""")).Больше(0);
	Ожидаем.Что(СтрНайти(Разметка, "class=""окружение активное""")).Больше(0);

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Таблица флагов

&Тест
&ОтображаемоеИмя("Пустой список флагов показывает приглашение создать первый")
Процедура ПустойСписокПоказываетПриглашение() Экспорт

	Разметка = Разметка().ТаблицаФлагов("dev", Новый Массив());

	Ожидаем.Что(СтрНайти(Разметка, "Флагов пока нет")).Больше(0);
	Ожидаем.Что(СтрНайти(Разметка, "<table")).Равно(0);

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Строка флага несёт адреса htmx для переключения и выкатки")
Процедура СтрокаНесётАдресаHtmx() Экспорт

	Разметка = Разметка().СтрокаФлага("dev", Флаг("new-checkout", Истина, 25));

	Ожидаем.Что(СтрНайти(Разметка, "hx-post=""/ui/flags/new-checkout/toggle?env=dev""")).Больше(0);
	Ожидаем.Что(СтрНайти(Разметка, "hx-post=""/ui/flags/new-checkout/rollout?env=dev""")).Больше(0);
	Ожидаем.Что(СтрНайти(Разметка, "id=""флаг-new-checkout""")).Больше(0);

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Состояние флага отражается в классе строки и подписи")
Процедура СостояниеОтражаетсяВРазметке() Экспорт

	Включённый = Разметка().СтрокаФлага("dev", Флаг("new-checkout", Истина, 100));
	Выключенный = Разметка().СтрокаФлага("dev", Флаг("new-checkout", Ложь, 0));

	Ожидаем.Что(СтрНайти(Включённый, "class=""включен""")).Больше(0);
	Ожидаем.Что(СтрНайти(Включённый, "включён")).Больше(0);
	Ожидаем.Что(СтрНайти(Выключенный, "class=""включен""")).Равно(0);
	Ожидаем.Что(СтрНайти(Выключенный, "выключен")).Больше(0);

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Нулевая выкатка выводится числом, а не пустой строкой")
Процедура НулеваяВыкаткаВыводитсяЧислом() Экспорт

	Разметка = Разметка().СтрокаФлага("dev", Флаг("new-checkout", Ложь, 0));

	Ожидаем.Что(СтрНайти(Разметка, "value=""0""")).Больше(0);
	Ожидаем.Что(СтрНайти(Разметка, "процент: 0")).Больше(0);

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Экранирование

&Тест
&ОтображаемоеИмя("Имя флага экранируется как текст")
Процедура ИмяФлагаЭкранируется() Экспорт

	Опасный = Флаг("new-checkout", Ложь, 0);
	Опасный.Вставить("имя", "<script>alert(1)</script>");

	Разметка = Разметка().СтрокаФлага("dev", Опасный);

	Ожидаем.Что(СтрНайти(Разметка, "<script>alert(1)</script>")).Равно(0);
	Ожидаем.Что(СтрНайти(Разметка, "&lt;script&gt;")).Больше(0);

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Кавычка в ключе не разрывает атрибут")
Процедура КавычкаВКлючеНеРазрываетАтрибут() Экспорт

	Разметка = Разметка().СтрокаФлага("dev", Флаг("ключ""onclick=", Ложь, 0));

	Ожидаем.Что(СтрНайти(Разметка, "id=""флаг-ключ""onclick=")).Равно(0);
	Ожидаем.Что(СтрНайти(Разметка, "&quot;")).Больше(0);

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Текст ошибки на странице входа экранируется")
Процедура ОшибкаВходаЭкранируется() Экспорт

	Разметка = Разметка().СтраницаВхода("<b>подбор</b>");

	Ожидаем.Что(СтрНайти(Разметка, "<b>подбор</b>")).Равно(0);
	Ожидаем.Что(СтрНайти(Разметка, "&lt;b&gt;")).Больше(0);

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Без ошибки страница входа не показывает пустое сообщение")
Процедура БезОшибкиСообщенияНет() Экспорт

	Разметка = Разметка().СтраницаВхода();

	Ожидаем.Что(СтрНайти(Разметка, "class=""ошибка""")).Равно(0);
	Ожидаем.Что(СтрНайти(Разметка, "name=""login""")).Больше(0);

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////

Функция Разметка()

	Возврат Новый РазметкаДашборда();

КонецФункции

Функция Окружения()

	Результат = Новый Массив();

	Для Каждого Ключ Из СтрРазделить("dev,prod", ",") Цикл
		Окружение = Новый Соответствие();
		Окружение.Вставить("ключ", Ключ);
		Результат.Добавить(Окружение);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция Флаги()

	Результат = Новый Массив();
	Результат.Добавить(Флаг("new-checkout", Истина, 50));

	Возврат Результат;

КонецФункции

Функция Флаг(Знач Ключ, Знач Включен, Знач Процент)

	Настройка = Новый Соответствие();
	Настройка.Вставить("включен", Включен);
	Настройка.Вставить("процентВыкатки", Процент);

	Результат = Новый Соответствие();
	Результат.Вставить("ключ", Ключ);
	Результат.Вставить("имя", "Новая оплата");
	Результат.Вставить("тип", "boolean");
	Результат.Вставить("настройка", Настройка);

	Возврат Результат;

КонецФункции
