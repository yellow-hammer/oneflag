#Использовать dotenv

Перем Значения;

&Желудь
Процедура ПриСозданииОбъекта()

	DotEnv.Загрузить(".env");
	Значения = Новый Соответствие();

КонецПроцедуры

// Порт HTTP-сервера.
Функция Порт() Экспорт

	Возврат Число(Прочитать("ONEFLAG_PORT", "3333"));

КонецФункции

// Вид хранилища: sqlite, postgresql, json или memory.
Функция ВидХранилища() Экспорт

	Возврат Прочитать("ONEFLAG_STORAGE_KIND", "sqlite");

КонецФункции

// Строка соединения с хранилищем.
//
// Для sqlite это путь к файлу базы, для json - каталог с таблицами,
// для postgresql - полная строка соединения, для memory - произвольная метка.
Функция СтрокаСоединения() Экспорт

	Возврат Прочитать("ONEFLAG_STORAGE", ЗначениеСоединенияПоУмолчанию());

КонецФункции

Функция ЗначениеСоединенияПоУмолчанию()

	Вид = НРег(СокрЛП(ВидХранилища()));

	Если Вид = "json" Тогда
		Возврат "data/flags";
	ИначеЕсли Вид = "postgresql" Тогда
		Возврат "Host=localhost;Port=5432;Database=oneflag;Username=oneflag;Password=oneflag";
	ИначеЕсли Вид = "memory" Тогда
		Возврат "oneflag";
	КонецЕсли;

	Возврат "data/oneflag.db";

КонецФункции

// Секрет для подписи JWT. В проде обязателен: значение по умолчанию
// пригодно только для локального запуска.
Функция СекретТокенов() Экспорт

	Возврат Прочитать("ONEFLAG_SECRET", "измените-этот-секрет-в-продакшене");

КонецФункции

// Срок жизни токена входа в секундах.
Функция СрокТокена() Экспорт

	Возврат Число(Прочитать("ONEFLAG_TOKEN_TTL", "28800"));

КонецФункции

// Логин администратора дашборда.
Функция ЛогинАдминистратора() Экспорт

	Возврат Прочитать("ONEFLAG_ADMIN_LOGIN", "admin");

КонецФункции

// Пароль администратора дашборда.
Функция ПарольАдминистратора() Экспорт

	Возврат Прочитать("ONEFLAG_ADMIN_PASSWORD", "admin");

КонецФункции

// Ключ, по которому SDK-клиенты читают флаги.
Функция КлючSDK() Экспорт

	Возврат Прочитать("ONEFLAG_SDK_KEY", "local-sdk-key");

КонецФункции

// Список окружений.
Функция Окружения() Экспорт

	Результат = Новый Массив();

	Для Каждого Ключ Из СтрРазделить(Прочитать("ONEFLAG_ENVIRONMENTS", "dev,stage,prod"), ",", Ложь) Цикл
		Если Не ПустаяСтрока(СокрЛП(Ключ)) Тогда
			Результат.Добавить(СокрЛП(Ключ));
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Окружение, которое открывается в дашборде по умолчанию.
Функция ОкружениеПоУмолчанию() Экспорт

	Возврат Прочитать("ONEFLAG_DEFAULT_ENVIRONMENT", Окружения()[0]);

КонецФункции

// Сколько записей аудита хранить.
Функция ПределАудита() Экспорт

	Возврат Число(Прочитать("ONEFLAG_AUDIT_LIMIT", "500"));

КонецФункции

// Топик SSE, на который подписываются дашборд, SDK и метрики.
Функция ТопикПотока() Экспорт

	Возврат "/stream";

КонецФункции

// Источник событий для CloudEvents.
Функция ИсточникСобытий() Экспорт

	Возврат Прочитать("ONEFLAG_EVENT_SOURCE", "/oneflag");

КонецФункции

// Адрес для вебхуков. Пустое значение отключает доставку.
Функция АдресВебхука() Экспорт

	Возврат Прочитать("ONEFLAG_WEBHOOK_URL", "");

КонецФункции

Функция Прочитать(Знач Имя, Знач ЗначениеПоУмолчанию)

	Известное = Значения.Получить(Имя);

	Если Известное <> Неопределено Тогда
		Возврат Известное;
	КонецЕсли;

	ИзОкружения = ПеременныеСреды().Получить(Имя);
	Результат = ?(ИзОкружения = Неопределено Или ПустаяСтрока(ИзОкружения), ЗначениеПоУмолчанию, ИзОкружения);

	Значения.Вставить(Имя, Результат);

	Возврат Результат;

КонецФункции

