#Использовать prometheus

// BSLLS:ExportVariables-off
Перем СчетчикЗапросов Экспорт;
Перем ИндикаторПриложения Экспорт;
// BSLLS:ExportVariables-on

&Контроллер("/metrics")
Процедура ПриСозданииОбъекта()

	Лейблы = Новый Соответствие();
	Лейблы.Вставить("handler", "/metrics");

	СчетчикЗапросов = Prometheus.НовыйСчетчик(
		"prometheus_client_http_requests_total",
		"Число HTTP-запросов к эндпоинту выдачи метрик",
		Лейблы);

	ИндикаторПриложения = Prometheus.НовыйИндикатор(
		"prometheus_client_up",
		"Клиент Prometheus: приложение отвечает (1)");

	Prometheus.Установить(ИндикаторПриложения, 1);

КонецПроцедуры

&ТочкаМаршрута("")
Процедура ОтдатьМетрики(Ответ) Экспорт

	Prometheus.Инкремент(СчетчикЗапросов);

	// Без явного текстового типа winow отдаёт text/html, и тело в браузере пусто
	Ответ.УстановитьТипКонтента("txt");
	Ответ.Заголовки["Content-Type"] = Prometheus.ContentTypeМетрик();
	Ответ.ТелоТекст = Prometheus.СериализоватьВТекст(Prometheus.СобратьМетрики());

КонецПроцедуры
