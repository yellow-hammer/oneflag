#Использовать 1commands
#Использовать fs

// Тесты выполняет OneUnit. Раннер ставится как dev-зависимость,
// поэтому вызывается из локального oscript_modules.
ПутьКОтчету = "out";
ФС.ОбеспечитьПустойКаталог(ПутьКОтчету);

СистемнаяИнформация = Новый СистемнаяИнформация;
ЭтоWindows = Найти(НРег(СистемнаяИнформация.ВерсияОС), "windows") > 0;

Команда = Новый Команда;
Команда.УстановитьКоманду(?(ЭтоWindows, "oscript_modules\bin\oneunit.bat", "./oscript_modules/bin/oneunit"));
Команда.ДобавитьПараметр("execute");
Команда.ДобавитьПараметр("-d");
Команда.ДобавитьПараметр("./tests");
Команда.ДобавитьПараметр("--junit");
Команда.ДобавитьПараметр(ОбъединитьПути(ПутьКОтчету, "junit.xml"));
Команда.ПоказыватьВыводНемедленно(Истина);

ЗавершитьРаботу(Команда.Исполнить());