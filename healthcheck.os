// Проверка живости для контейнера: сервер обязан ответить 200 на /healthz.
//
// Лежит вне каталога src, потому что autumn сканирует его и подхватил бы
// этот скрипт как компонент приложения.

Перем Порт;

Порт = ПеременныеСреды().Получить("ONEFLAG_PORT");
Порт = ?(Порт = Неопределено Или ПустаяСтрока(Порт), 3333, Число(Порт));

Попытка

	Соединение = Новый HTTPСоединение("localhost", Порт);
	Ответ = Соединение.Получить(Новый HTTPЗапрос("/healthz"));

	Если Ответ.КодСостояния <> 200 Тогда
		Сообщить(СтрШаблон("Сервер ответил %1", Формат(Ответ.КодСостояния, "ЧГ=0; ЧН=0")));
		ЗавершитьРаботу(1);
	КонецЕсли;

Исключение

	Сообщить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	ЗавершитьРаботу(1);

КонецПопытки;

ЗавершитьРаботу(0);
