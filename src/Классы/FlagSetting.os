// Идентификатор - окружение и ключ флага, склеенные через двоеточие.

&Идентификатор
&Колонка
Перем Ключ Экспорт;

&Колонка
Перем КлючФлага Экспорт;

&Колонка
Перем КлючОкружения Экспорт;

&Колонка(Тип = "Булево")
Перем Включен Экспорт;

&Колонка
Перем ВариантПоУмолчанию Экспорт;

&Колонка(Тип = "Целое")
Перем ПроцентВыкатки Экспорт;

&Колонка
Перем ПравилаJson Экспорт;

&Сущность(ИмяТаблицы = "НастройкиФлагов")
Процедура ПриСозданииОбъекта()

	Ключ = "";
	КлючФлага = "";
	КлючОкружения = "";
	Включен = Ложь;
	ВариантПоУмолчанию = "";
	ПроцентВыкатки = 100;
	ПравилаJson = "[]";

КонецПроцедуры
