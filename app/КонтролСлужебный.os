&Пластилин Перем ХранилищеФлагов;
&Пластилин Перем СервисСобытий;

&Контроллер("/")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ТочкаМаршрута("healthz")
&НеВыводитОтображениеКонтроллера
Процедура Здоровье(Ответ) Экспорт

	Состояние = Новый Соответствие();

	Попытка
		Состояние.Вставить("status", "ok");
		Состояние.Вставить("flags", ХранилищеФлагов.Флаги().Количество());
		Состояние.Вставить("environments", ХранилищеФлагов.Окружения().Количество());
		Состояние.Вставить("subscribers", СервисСобытий.КоличествоПодписчиков());
		Ответ.УстановитьСостояние(200);
	Исключение
		Состояние.Вставить("status", "error");
		Состояние.Вставить("error", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Ответ.УстановитьСостояние(503);
	КонецПопытки;

	Ответ.Заголовки["Content-Type"] = "application/json; charset=utf-8";

	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, Состояние);

	Ответ.ТелоТекст = Запись.Закрыть();

КонецПроцедуры

