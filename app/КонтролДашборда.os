#Использовать winow-view

&Пластилин Перем ХранилищеФлагов;
&Пластилин Перем СервисСобытий;
&Пластилин Перем СервисБезопасности;
&Пластилин Перем РазметкаДашборда;
&Пластилин Перем Конфигурация;

&Контроллер("/")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ТочкаМаршрута("")
&НеВыводитОтображениеКонтроллера
Процедура Главная(Запрос, Ответ) Экспорт

	Пользователь = Вошедший(Запрос);

	Если ПустаяСтрока(Пользователь) Тогда
		Ответ.Перенаправить("/login");
		Возврат;
	КонецЕсли;

	Окружение = ОкружениеЗапроса(Запрос);

	ВернутьHtml(Ответ, 200, РазметкаДашборда.Страница(Окружение, ХранилищеФлагов.Окружения(),
		СписокФлагов(Окружение), Пользователь));

КонецПроцедуры

&ТочкаМаршрута("login")
&НеВыводитОтображениеКонтроллера
Процедура Вход(Запрос, Ответ) Экспорт

	Если Запрос.Метод <> "POST" Тогда
		ВернутьHtml(Ответ, 200, РазметкаДашборда.СтраницаВхода());
		Возврат;
	КонецЕсли;

	Поля = РазобратьФорму(Запрос.Тело);
	Токен = СервисБезопасности.Войти(Поля.Получить("login"), Поля.Получить("password"));

	Если ПустаяСтрока(Токен) Тогда
		ВернутьHtml(Ответ, 401, РазметкаДашборда.СтраницаВхода("Неверный логин или пароль"));
		Возврат;
	КонецЕсли;

	// Токен кладём в куку средствами winow: сервер добавляет к ответу и свою
	// куку сессии, а прямая запись заголовка Set-Cookie затёрла бы одну из них
	Кука = Ответ.Куки.Добавить(СервисБезопасности.ИмяКукиТокена(), Токен);
	Кука.Путь = "/";
	Кука.СрокЖизни = Конфигурация.СрокТокена();
	// Недоступна из JavaScript - это защищает токен при XSS в дашборде
	Кука.ТолькоХттп = Истина;
	Кука.ТотжеСайт = "Lax";

	Ответ.Перенаправить("/");

КонецПроцедуры

&ТочкаМаршрута("logout")
&НеВыводитОтображениеКонтроллера
Процедура Выход(Ответ) Экспорт

	Кука = Ответ.Куки.Добавить(СервисБезопасности.ИмяКукиТокена(), "");
	Кука.Путь = "/";
	Кука.СрокЖизни = 0;
	Кука.ТолькоХттп = Истина;

	Ответ.Перенаправить("/login");

КонецПроцедуры

&ТочкаМаршрута("ui/flags")
&НеВыводитОтображениеКонтроллера
Процедура ФрагментФлагов(Запрос, Ответ) Экспорт

	Если Не Разрешено(Запрос, Ответ) Тогда
		Возврат;
	КонецЕсли;

	Окружение = ОкружениеЗапроса(Запрос);

	Если Запрос.Метод = "POST" Тогда
		СоздатьФлаг(Запрос, Ответ, Окружение);
		Возврат;
	КонецЕсли;

	ВернутьHtml(Ответ, 200, РазметкаДашборда.ТаблицаФлагов(Окружение, СписокФлагов(Окружение)));

КонецПроцедуры

&ТочкаМаршрута("ui/flags/{ключ}/toggle")
&НеВыводитОтображениеКонтроллера
Процедура Переключить(Запрос, Ответ, ключ) Экспорт

	Если Не Разрешено(Запрос, Ответ) Тогда
		Возврат;
	КонецЕсли;

	Окружение = ОкружениеЗапроса(Запрос);
	Настройка = ХранилищеФлагов.Снимок(Окружение).Получить(ключ);

	Если Настройка = Неопределено Тогда
		ВернутьHtml(Ответ, 404, "<tr><td colspan=""5"">Флаг не найден</td></tr>");
		Возврат;
	КонецЕсли;

	Изменения = Новый Соответствие();
	Изменения.Вставить("включен", Не (Настройка["включен"] = Истина));

	ПрименитьИОтветитьСтрокой(Запрос, Ответ, ключ, Окружение, Изменения);

КонецПроцедуры

&ТочкаМаршрута("ui/flags/{ключ}/rollout")
&НеВыводитОтображениеКонтроллера
Процедура ИзменитьВыкатку(Запрос, Ответ, ключ) Экспорт

	Если Не Разрешено(Запрос, Ответ) Тогда
		Возврат;
	КонецЕсли;

	Поля = РазобратьФорму(Запрос.Тело);

	Изменения = Новый Соответствие();
	Изменения.Вставить("процентВыкатки", Число(?(Поля.Получить("процент") = Неопределено, "100", Поля.Получить("процент"))));

	ПрименитьИОтветитьСтрокой(Запрос, Ответ, ключ, ОкружениеЗапроса(Запрос), Изменения);

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////

Процедура ПрименитьИОтветитьСтрокой(Запрос, Ответ, Знач Ключ, Знач Окружение, Знач Изменения)

	Попытка
		ХранилищеФлагов.ОбновитьНастройку(Ключ, Окружение, Изменения);
	Исключение
		ВернутьHtml(Ответ, 400, СтрШаблон("<tr><td colspan=""5"">%1</td></tr>",
			View.ЭкранироватьHtml(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()))));
		Возврат;
	КонецПопытки;

	Настройка = ХранилищеФлагов.Снимок(Окружение).Получить(Ключ);

	Данные = Новый Соответствие();
	Данные.Вставить("включен", Настройка["включен"]);
	Данные.Вставить("процентВыкатки", Настройка["процентВыкатки"]);

	СервисСобытий.Опубликовать("com.oneflag.flag.changed", Окружение, Ключ, Данные, Вошедший(Запрос));

	ВернутьHtml(Ответ, 200, РазметкаДашборда.СтрокаФлага(Окружение, СтрокаСписка(Окружение, Ключ)));

КонецПроцедуры

Процедура СоздатьФлаг(Запрос, Ответ, Знач Окружение)

	Поля = РазобратьФорму(Запрос.Тело);

	Описание = Новый Соответствие();
	Описание.Вставить("ключ", Поля.Получить("ключ"));
	Описание.Вставить("имя", Поля.Получить("имя"));
	Описание.Вставить("тип", ?(Поля.Получить("тип") = Неопределено, "boolean", Поля.Получить("тип")));

	Попытка
		Созданный = ХранилищеФлагов.СоздатьФлаг(Описание);
	Исключение
		ВернутьHtml(Ответ, 400, СтрШаблон("<p class=""ошибка"">%1</p>%2",
			View.ЭкранироватьHtml(КраткоеПредставлениеОшибки(ИнформацияОбОшибке())),
			РазметкаДашборда.ТаблицаФлагов(Окружение, СписокФлагов(Окружение))));
		Возврат;
	КонецПопытки;

	Данные = Новый Соответствие();
	Данные.Вставить("тип", Созданный["тип"]);

	СервисСобытий.Опубликовать("com.oneflag.flag.created", Окружение, Созданный["ключ"], Данные, Вошедший(Запрос));

	ВернутьHtml(Ответ, 200, РазметкаДашборда.ТаблицаФлагов(Окружение, СписокФлагов(Окружение)));

КонецПроцедуры

Функция СписокФлагов(Знач Окружение)

	Снимок = ХранилищеФлагов.Снимок(Окружение);
	Результат = Новый Массив();

	Для Каждого Описание Из ХранилищеФлагов.Флаги() Цикл

		Запись = Новый Соответствие();
		Запись.Вставить("ключ", Описание["ключ"]);
		Запись.Вставить("имя", Описание["имя"]);
		Запись.Вставить("тип", Описание["тип"]);
		Запись.Вставить("настройка", Снимок.Получить(Описание["ключ"]));

		Результат.Добавить(Запись);

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция СтрокаСписка(Знач Окружение, Знач Ключ)

	Для Каждого Запись Из СписокФлагов(Окружение) Цикл
		Если Запись["ключ"] = Ключ Тогда
			Возврат Запись;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция Вошедший(Запрос)

	Проверка = СервисБезопасности.ПроверитьТокен(СервисБезопасности.ТокенЗапроса(Запрос));

	Возврат ?(Проверка["валиден"], Проверка["пользователь"], "");

КонецФункции

Функция Разрешено(Запрос, Ответ)

	Если Не ПустаяСтрока(Вошедший(Запрос)) Тогда
		Возврат Истина;
	КонецЕсли;

	Ответ.УстановитьСостояние(401);
	// htmx выполняет свои запросы через fetch, поэтому обычное перенаправление
	// сменило бы адрес только у фрагмента - браузеру нужен заголовок HX-Redirect
	View.Перенаправить(Ответ.Заголовки, "/login");
	Ответ.ТелоТекст = "";

	Возврат Ложь;

КонецФункции

Функция ОкружениеЗапроса(Запрос)

	Если Запрос.ПараметрыИменные <> Неопределено Тогда
		Значение = Запрос.ПараметрыИменные.Получить("env");
		Если Значение <> Неопределено И Не ПустаяСтрока(Строка(Значение)) Тогда
			Возврат Строка(Значение);
		КонецЕсли;
	КонецЕсли;

	Возврат Конфигурация.ОкружениеПоУмолчанию();

КонецФункции

Функция РазобратьФорму(Знач Тело)

	Результат = Новый Соответствие();

	Если Тело = Неопределено Или ПустаяСтрока(Тело) Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Пара Из СтрРазделить(Тело, "&", Ложь) Цикл

		Позиция = СтрНайти(Пара, "=");

		Если Позиция = 0 Тогда
			Продолжить;
		КонецЕсли;

		Результат.Вставить(
			РаскодироватьЗначениеФормы(Лев(Пара, Позиция - 1)),
			РаскодироватьЗначениеФормы(Сред(Пара, Позиция + 1)));

	КонецЦикла;

	Возврат Результат;

КонецФункции

// В application/x-www-form-urlencoded пробел кодируется знаком плюс, а
// РаскодироватьСтроку разворачивает только последовательности вида %XX,
// поэтому плюс заменяется до раскодирования.
//
Функция РаскодироватьЗначениеФормы(Знач Значение)

	Возврат РаскодироватьСтроку(СтрЗаменить(Значение, "+", " "), СпособКодированияСтроки.КодировкаURL);

КонецФункции

Процедура ВернутьHtml(Ответ, Знач Код, Знач Разметка)

	Ответ.УстановитьСостояние(Код);
	Ответ.Заголовки["Content-Type"] = "text/html; charset=utf-8";
	Ответ.ТелоТекст = Разметка;

КонецПроцедуры

