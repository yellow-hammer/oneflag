#Использовать prometheus

&Пластилин Перем ХранилищеФлагов;
&Пластилин Перем БрокерСообщенийСобытийСервера;
&Пластилин Перем Конфигурация;

Перем ИзмененияФлагов;
Перем ОценкиФлагов;
Перем СостояниеСобирается;

&Желудь
Процедура ПриСозданииОбъекта()

	ИзмененияФлагов = Prometheus.НовыйСчетчикВектор(
		"oneflag_flag_changes_total",
		"Изменения флагов по окружениям и типам событий",
		ИменаЛейблов("environment", "event"));

	ОценкиФлагов = Prometheus.НовыйСчетчикВектор(
		"oneflag_flag_evaluations_total",
		"Оценки флагов по окружениям и причинам решения",
		ИменаЛейблов("environment", "reason"));

	СостояниеСобирается = Ложь;

КонецПроцедуры

// Подключает сбор состояния к реестру prometheus. Вызывается при запуске
// сервера, команды CLI к хранилищу за метриками не обращаются.
//
Процедура Подключить() Экспорт

	Если СостояниеСобирается Тогда
		Возврат;
	КонецЕсли;

	Prometheus.РеестрПоУмолчанию().Register(ЭтотОбъект);
	СостояниеСобирается = Истина;

КонецПроцедуры

// Учитывает изменение флага.
//
// Параметры:
//   Окружение  - Строка - ключ окружения.
//   ТипСобытия - Строка - тип в нотации CloudEvents.
//
Процедура УчестьИзменение(Знач Окружение, Знач ТипСобытия) Экспорт

	Prometheus.Инкремент(Prometheus.СчетчикСЛейблами(ИзмененияФлагов,
		Лейблы("environment", Окружение, "event", ТипСобытия)));

КонецПроцедуры

// Учитывает оценку флага.
//
// Параметры:
//   Окружение - Строка - ключ окружения.
//   Причина   - Строка - причина решения по словарю OpenFeature.
//
Процедура УчестьОценку(Знач Окружение, Знач Причина) Экспорт

	Prometheus.Инкремент(Prometheus.СчетчикСЛейблами(ОценкиФлагов,
		Лейблы("environment", Окружение, "reason", Причина)));

КонецПроцедуры

// Собирает текущее состояние сервиса. Метод вызывает реестр prometheus,
// поэтому имя английское и без параметров - таков контракт коллектора.
//
// Возвращаемое значение:
//   Массив - семейства метрик.
//
Функция Collect() Экспорт

	Семейства = Новый Массив();

	ДобавитьИндикатор(Семейства, "oneflag_flags",
		"Количество флагов в хранилище", ЧислоФлагов());

	ДобавитьИндикатор(Семейства, "oneflag_environments",
		"Количество окружений", ЧислоОкружений());

	ДобавитьИндикатор(Семейства, "oneflag_stream_subscribers",
		"Число открытых подписок на поток изменений", ЧислоПодписчиков());

	ДобавитьИндикатор(Семейства, "oneflag_audit_records",
		"Количество записей в журнале аудита", ЧислоЗаписейАудита());

	Возврат Семейства;

КонецФункции

////////////////////////////////////////////////////////////////////////////////

// При недоступном хранилище возвращает -1: отдача метрик не должна падать,
// а -1 отличимо от честного нуля.
//
Функция ЧислоФлагов()

	Попытка
		Возврат ХранилищеФлагов.Флаги().Количество();
	Исключение
		Возврат -1;
	КонецПопытки;

КонецФункции

Функция ЧислоОкружений()

	Попытка
		Возврат ХранилищеФлагов.Окружения().Количество();
	Исключение
		Возврат -1;
	КонецПопытки;

КонецФункции

Функция ЧислоПодписчиков()

	Попытка
		Возврат БрокерСообщенийСобытийСервера.КоличествоСоединений(Конфигурация.ТопикПотока());
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

Функция ЧислоЗаписейАудита()

	Попытка
		Возврат ХранилищеФлагов.Аудит(Конфигурация.ПределАудита()).Количество();
	Исключение
		Возврат -1;
	КонецПопытки;

КонецФункции

Процедура ДобавитьИндикатор(Семейства, Знач Имя, Знач Справка, Знач Значение)

	Сэмпл = Новый Структура("ИмяСэмпла, Лейблы, Значение", Имя, Новый Соответствие(), Значение);

	Сэмплы = Новый Массив();
	Сэмплы.Добавить(Сэмпл);

	Семейства.Добавить(Новый Структура("Имя, Тип, Справка, Сэмплы", Имя, "gauge", Справка, Сэмплы));

КонецПроцедуры

Функция ИменаЛейблов(Знач Первое, Знач Второе)

	Результат = Новый Массив();
	Результат.Добавить(Первое);
	Результат.Добавить(Второе);

	Возврат Результат;

КонецФункции

Функция Лейблы(Знач ПервоеИмя, Знач ПервоеЗначение, Знач ВтороеИмя, Знач ВтороеЗначение)

	Результат = Новый Соответствие();
	Результат.Вставить(ПервоеИмя, ПервоеЗначение);
	Результат.Вставить(ВтороеИмя, ВтороеЗначение);

	Возврат Результат;

КонецФункции
