#Использовать asserts
#Использовать autumn
#Использовать ".."

// Тесты работают на коннекторе InMemory: та же логика хранилища, но без файлов
// и без внешней СУБД. Вид хранилища задаётся переменной окружения, поэтому
// прикладной код для этого менять не нужно.

&ПередКаждым
Процедура ПередКаждымТестом() Экспорт

	УстановитьПеременнуюСреды("ONEFLAG_STORAGE_KIND", "memory");
	УстановитьПеременнуюСреды("ONEFLAG_STORAGE", Строка(Новый УникальныйИдентификатор()));

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Окружения

&Тест
&ОтображаемоеИмя("Окружения из настроек создаются при инициализации")
Процедура ОкруженияСоздаютсяПриИнициализации() Экспорт

	Хранилище = Хранилище();

	Ключи = Новый Массив();
	Для Каждого Окружение Из Хранилище.Окружения() Цикл
		Ключи.Добавить(Окружение["ключ"]);
	КонецЦикла;

	Ожидаем.Что(Ключи.Количество()).Больше(0);
	Ожидаем.Что(Хранилище.ОкружениеСуществует(Ключи[0])).ЭтоИстина();
	Ожидаем.Что(Хранилище.ОкружениеСуществует("нет-такого")).ЭтоЛожь();

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Создание флагов

&Тест
&ОтображаемоеИмя("Флаг создаётся с настройками во всех окружениях")
Процедура ФлагСоздаётсяСНастройками() Экспорт

	Хранилище = Хранилище();

	Созданный = Хранилище.СоздатьФлаг(ОписаниеФлага("new-checkout"));

	Ожидаем.Что(Созданный["ключ"]).Равно("new-checkout");
	Ожидаем.Что(Созданный["тип"]).Равно("boolean");
	Ожидаем.Что(Созданный["варианты"]["вкл"]).ЭтоИстина();
	Ожидаем.Что(Созданный["настройки"].Количество()).Равно(Хранилище.Окружения().Количество());

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Новый флаг выключен во всех окружениях")
Процедура НовыйФлагВыключен() Экспорт

	Хранилище = Хранилище();
	Хранилище.СоздатьФлаг(ОписаниеФлага("new-checkout"));

	Для Каждого Окружение Из Хранилище.Окружения() Цикл
		Настройка = Хранилище.Снимок(Окружение["ключ"])["new-checkout"];
		Ожидаем.Что(Настройка["включен"], "Окружение " + Окружение["ключ"]).ЭтоЛожь();
	КонецЦикла;

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Повторное создание флага отвергается")
Процедура ПовторноеСозданиеОтвергается() Экспорт

	Хранилище = Хранилище();
	Хранилище.СоздатьФлаг(ОписаниеФлага("new-checkout"));

	Ожидаем.Что(Хранилище).Метод("СоздатьФлаг", Аргументы(ОписаниеФлага("new-checkout"))).ВыбрасываетИсключение();

КонецПроцедуры

&ПараметризованныйТест(Имя = "Некорректный ключ флага отвергается: {Параметры}")
&ИсточникЗначение("")
&ИсточникЗначение("ключ с пробелом")
&ИсточникЗначение("русский-ключ")
&ИсточникЗначение("слэш/внутри")
Процедура НекорректныйКлючОтвергается(Знач Ключ) Экспорт

	Ожидаем.Что(Хранилище()).Метод("СоздатьФлаг", Аргументы(ОписаниеФлага(Ключ))).ВыбрасываетИсключение();

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Неизвестный тип флага отвергается")
Процедура НеизвестныйТипОтвергается() Экспорт

	Описание = ОписаниеФлага("new-checkout");
	Описание.Вставить("тип", "непонятный");

	Ожидаем.Что(Хранилище()).Метод("СоздатьФлаг", Аргументы(Описание)).ВыбрасываетИсключение();

КонецПроцедуры

&ПараметризованныйТест(Имя = "Варианты по умолчанию зависят от типа: {Параметры}")
&ИсточникЗначение("boolean", "вкл")
&ИсточникЗначение("string", "значение")
&ИсточникЗначение("number", "значение")
Процедура ВариантыПоУмолчаниюЗависятОтТипа(Знач ТипФлага, Знач ОжидаемыйВариант) Экспорт

	Описание = ОписаниеФлага("typed-flag");
	Описание.Вставить("тип", ТипФлага);

	Созданный = Хранилище().СоздатьФлаг(Описание);

	Ожидаем.Что(Созданный["варианты"].Получить(ОжидаемыйВариант)).Не_().ЭтоНеопределено();

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Изменение настроек

&Тест
&ОтображаемоеИмя("Настройка меняется только в своём окружении")
Процедура НастройкаМеняетсяТолькоВСвоёмОкружении() Экспорт

	Хранилище = Хранилище();
	Хранилище.СоздатьФлаг(ОписаниеФлага("new-checkout"));

	Изменения = Новый Соответствие();
	Изменения.Вставить("включен", Истина);

	Хранилище.ОбновитьНастройку("new-checkout", "dev", Изменения);

	Ожидаем.Что(Хранилище.Снимок("dev")["new-checkout"]["включен"]).ЭтоИстина();
	Ожидаем.Что(Хранилище.Снимок("prod")["new-checkout"]["включен"]).ЭтоЛожь();

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Процент выкатки сохраняется")
Процедура ПроцентВыкаткиСохраняется() Экспорт

	Хранилище = Хранилище();
	Хранилище.СоздатьФлаг(ОписаниеФлага("new-checkout"));

	Изменения = Новый Соответствие();
	Изменения.Вставить("процентВыкатки", 25);

	Хранилище.ОбновитьНастройку("new-checkout", "dev", Изменения);

	Ожидаем.Что(Хранилище.Снимок("dev")["new-checkout"]["процентВыкатки"]).Равно(25);

КонецПроцедуры

&ПараметризованныйТест(Имя = "Процент вне диапазона отвергается: {Параметры}")
&ИсточникЗначение(-1)
&ИсточникЗначение(101)
Процедура ПроцентВнеДиапазонаОтвергается(Знач Процент) Экспорт

	Хранилище = Хранилище();
	Хранилище.СоздатьФлаг(ОписаниеФлага("new-checkout"));

	Изменения = Новый Соответствие();
	Изменения.Вставить("процентВыкатки", Процент);

	Ожидаем.Что(Хранилище).Метод("ОбновитьНастройку",
		Аргументы("new-checkout", "dev", Изменения)).ВыбрасываетИсключение();

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Правила таргетинга сохраняются и нормализуются")
Процедура ПравилаСохраняютсяИНормализуются() Экспорт

	Хранилище = Хранилище();
	Хранилище.СоздатьФлаг(ОписаниеФлага("new-checkout"));

	Хранилище.ОбновитьНастройку("new-checkout", "dev", ИзмененияСПравилом("plan", "равно", "pro", "вкл"));

	Правила = Хранилище.Снимок("dev")["new-checkout"]["правила"];

	Ожидаем.Что(Правила.Количество()).Равно(1);
	Ожидаем.Что(Правила[0]["атрибут"]).Равно("plan");
	Ожидаем.Что(Правила[0]["оператор"]).Равно("равно");
	Ожидаем.Что(Правила[0]["значения"][0]).Равно("pro");
	Ожидаем.Что(Правила[0]["вариант"]).Равно("вкл");

КонецПроцедуры

&ПараметризованныйТест(Имя = "Оператор сравнения версий принимается: {Параметры}")
&ИсточникЗначение("версия равна")
&ИсточникЗначение("версия больше")
&ИсточникЗначение("версия меньше")
&ИсточникЗначение("версия в диапазоне")
Процедура ОператорВерсийПринимается(Знач Оператор) Экспорт

	Хранилище = Хранилище();
	Хранилище.СоздатьФлаг(ОписаниеФлага("new-checkout"));

	Хранилище.ОбновитьНастройку("new-checkout", "dev",
		ИзмененияСПравилом("appVersion", Оператор, "1.10.0", "вкл"));

	Правила = Хранилище.Снимок("dev")["new-checkout"]["правила"];

	Ожидаем.Что(Правила[0]["оператор"]).Равно(Оператор);

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Правило с неизвестным оператором отвергается")
Процедура НеизвестныйОператорОтвергается() Экспорт

	Хранилище = Хранилище();
	Хранилище.СоздатьФлаг(ОписаниеФлага("new-checkout"));

	Ожидаем.Что(Хранилище).Метод("ОбновитьНастройку",
		Аргументы("new-checkout", "dev", ИзмененияСПравилом("plan", "похоже на", "pro", "вкл"))).ВыбрасываетИсключение();

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Правило со ссылкой на неописанный вариант отвергается")
Процедура НеописанныйВариантОтвергается() Экспорт

	Хранилище = Хранилище();
	Хранилище.СоздатьФлаг(ОписаниеФлага("new-checkout"));

	Ожидаем.Что(Хранилище).Метод("ОбновитьНастройку",
		Аргументы("new-checkout", "dev", ИзмененияСПравилом("plan", "равно", "pro", "нет-варианта"))).ВыбрасываетИсключение();

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Изменение неизвестного флага или окружения отвергается")
Процедура ИзменениеНеизвестногоОтвергается() Экспорт

	Хранилище = Хранилище();
	Хранилище.СоздатьФлаг(ОписаниеФлага("new-checkout"));

	Изменения = Новый Соответствие();
	Изменения.Вставить("включен", Истина);

	Ожидаем.Что(Хранилище).Метод("ОбновитьНастройку", Аргументы("нет-флага", "dev", Изменения)).ВыбрасываетИсключение();
	Ожидаем.Что(Хранилище).Метод("ОбновитьНастройку", Аргументы("new-checkout", "нет-среды", Изменения)).ВыбрасываетИсключение();

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Удаление

&Тест
&ОтображаемоеИмя("Удаление флага убирает и его настройки")
Процедура УдалениеУбираетНастройки() Экспорт

	Хранилище = Хранилище();
	Хранилище.СоздатьФлаг(ОписаниеФлага("new-checkout"));

	Ожидаем.Что(Хранилище.УдалитьФлаг("new-checkout")).ЭтоИстина();
	Ожидаем.Что(Хранилище.Флаг("new-checkout")).ЭтоНеопределено();
	Ожидаем.Что(Хранилище.Снимок("dev").Количество()).Равно(0);

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Удаление отсутствующего флага возвращает Ложь")
Процедура УдалениеОтсутствующегоФлага() Экспорт

	Ожидаем.Что(Хранилище().УдалитьФлаг("нет-такого")).ЭтоЛожь();

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Журнал аудита

&Тест
&ОтображаемоеИмя("Записи аудита возвращаются свежими первыми")
Процедура АудитВозвращаетСвежиеПервыми() Экспорт

	Хранилище = Хранилище();

	Хранилище.ДобавитьВАудит(СобытиеАудита("01AAA", "com.oneflag.flag.created"));
	Хранилище.ДобавитьВАудит(СобытиеАудита("01BBB", "com.oneflag.flag.changed"));

	Записи = Хранилище.Аудит(10);

	Ожидаем.Что(Записи.Количество()).Равно(2);
	Ожидаем.Что(Записи[0]["id"]).Равно("01BBB");
	Ожидаем.Что(Записи[1]["id"]).Равно("01AAA");

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Предел выборки аудита соблюдается")
Процедура ПределВыборкиАудита() Экспорт

	Хранилище = Хранилище();

	Для Счётчик = 1 По 5 Цикл
		Хранилище.ДобавитьВАудит(СобытиеАудита("01AA" + Счётчик, "com.oneflag.flag.changed"));
	КонецЦикла;

	Ожидаем.Что(Хранилище.Аудит(3).Количество()).Равно(3);

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Событие аудита сохраняется без потерь")
Процедура СобытиеАудитаБезПотерь() Экспорт

	Хранилище = Хранилище();
	Хранилище.ДобавитьВАудит(СобытиеАудита("01AAA", "com.oneflag.flag.changed"));

	Запись = Хранилище.Аудит(1)[0];

	Ожидаем.Что(Запись["type"]).Равно("com.oneflag.flag.changed");
	Ожидаем.Что(Запись["data"]["флаг"]).Равно("new-checkout");
	Ожидаем.Что(Запись["data"]["автор"]).Равно("admin");

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Персистентность

&Тест
&ОтображаемоеИмя("Данные переживают пересоздание хранилища")
Процедура ДанныеПереживаютПересоздание() Экспорт

	Первое = Хранилище();
	Первое.СоздатьФлаг(ОписаниеФлага("new-checkout"));

	Изменения = Новый Соответствие();
	Изменения.Вставить("включен", Истина);
	Первое.ОбновитьНастройку("new-checkout", "dev", Изменения);

	// Новый экземпляр подключается к той же базе: строка соединения не меняется
	Второе = Хранилище();

	Ожидаем.Что(Второе.Снимок("dev")["new-checkout"]["включен"]).ЭтоИстина();

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////

Функция Хранилище()

	Поделка = Новый Поделка;
	Поделка.ЗапуститьПриложение();

	Хранилище = Поделка.НайтиЖелудь("ХранилищеФлагов");
	Хранилище.УбедитьсяЧтоГотово();

	Возврат Хранилище;

КонецФункции

Функция ОписаниеФлага(Знач Ключ)

	Результат = Новый Соответствие();
	Результат.Вставить("ключ", Ключ);
	Результат.Вставить("имя", "Флаг " + Ключ);
	Результат.Вставить("тип", "boolean");

	Возврат Результат;

КонецФункции

Функция ИзмененияСПравилом(Знач Атрибут, Знач Оператор, Знач Значение, Знач Вариант)

	Значения = Новый Массив();
	Значения.Добавить(Значение);

	Правило = Новый Соответствие();
	Правило.Вставить("атрибут", Атрибут);
	Правило.Вставить("оператор", Оператор);
	Правило.Вставить("значения", Значения);
	Правило.Вставить("вариант", Вариант);

	Правила = Новый Массив();
	Правила.Добавить(Правило);

	Результат = Новый Соответствие();
	Результат.Вставить("правила", Правила);

	Возврат Результат;

КонецФункции

Функция СобытиеАудита(Знач Идентификатор, Знач ТипСобытия)

	Данные = Новый Соответствие();
	Данные.Вставить("окружение", "dev");
	Данные.Вставить("флаг", "new-checkout");
	Данные.Вставить("автор", "admin");

	Результат = Новый Соответствие();
	Результат.Вставить("specversion", "1.0");
	Результат.Вставить("id", Идентификатор);
	Результат.Вставить("source", "/oneflag");
	Результат.Вставить("type", ТипСобытия);
	Результат.Вставить("time", "2026-08-04T21:00:00Z");
	Результат.Вставить("data", Данные);

	Возврат Результат;

КонецФункции

Функция Аргументы(Знач Первый, Знач Второй = Неопределено, Знач Третий = Неопределено)

	Результат = Новый Массив();
	Результат.Добавить(Первый);

	Если Второй <> Неопределено Тогда
		Результат.Добавить(Второй);
	КонецЕсли;

	Если Третий <> Неопределено Тогда
		Результат.Добавить(Третий);
	КонецЕсли;

	Возврат Результат;

КонецФункции

