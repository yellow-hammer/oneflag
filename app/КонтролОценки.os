#Использовать problem-details

&Пластилин Перем ХранилищеФлагов;
&Пластилин Перем СервисОценки;
&Пластилин Перем СервисБезопасности;
&Пластилин Перем Конфигурация;

&Контроллер("/api")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ТочкаМаршрута("evaluate")
&НеВыводитОтображениеКонтроллера
Процедура Оценить(Запрос, Ответ) Экспорт

	Если Не Авторизован(Запрос, Ответ) Тогда
		Возврат;
	КонецЕсли;

	Тело = ТелоЗапроса(Запрос);

	Если Тело = Неопределено Тогда
		ВернутьПроблему(Ответ, 400, "Тело запроса должно быть объектом JSON");
		Возврат;
	КонецЕсли;

	Ключ = Строка(Значение(Тело, "flagKey", ""));

	Если ПустаяСтрока(Ключ) Тогда
		ВернутьПроблему(Ответ, 400, "Не задан flagKey");
		Возврат;
	КонецЕсли;

	Окружение = ОкружениеЗапроса(Запрос, Тело);

	Если Не ХранилищеФлагов.ОкружениеСуществует(Окружение) Тогда
		ВернутьПроблему(Ответ, 404, СтрШаблон("Окружение %1 не найдено", Окружение));
		Возврат;
	КонецЕсли;

	Оценка = СервисОценки.Оценить(Ключ, Окружение, Значение(Тело, "context"),
		Значение(Тело, "defaultValue"));

	Результат = Новый Соответствие();
	Результат.Вставить("flagKey", Ключ);
	Результат.Вставить("value", Оценка["значение"]);
	Результат.Вставить("variant", Оценка["вариант"]);
	Результат.Вставить("reason", Оценка["причина"]);
	Результат.Вставить("errorCode", Оценка["кодОшибки"]);

	ВернутьJson(Ответ, 200, Результат);

КонецПроцедуры

&ТочкаМаршрута("evaluate/all")
&НеВыводитОтображениеКонтроллера
Процедура ОценитьВсе(Запрос, Ответ) Экспорт

	Если Не Авторизован(Запрос, Ответ) Тогда
		Возврат;
	КонецЕсли;

	Тело = ТелоЗапроса(Запрос);
	Окружение = ОкружениеЗапроса(Запрос, Тело);

	Если Не ХранилищеФлагов.ОкружениеСуществует(Окружение) Тогда
		ВернутьПроблему(Ответ, 404, СтрШаблон("Окружение %1 не найдено", Окружение));
		Возврат;
	КонецЕсли;

	Оценки = СервисОценки.ОценитьВсе(Окружение, Значение(Тело, "context"));

	Флаги = Новый Соответствие();

	Для Каждого Элемент Из Оценки Цикл
		Запись = Новый Соответствие();
		Запись.Вставить("value", Элемент.Значение["значение"]);
		Запись.Вставить("variant", Элемент.Значение["вариант"]);
		Запись.Вставить("reason", Элемент.Значение["причина"]);
		Флаги.Вставить(Элемент.Ключ, Запись);
	КонецЦикла;

	Результат = Новый Соответствие();
	Результат.Вставить("environment", Окружение);
	Результат.Вставить("flags", Флаги);

	ВернутьJson(Ответ, 200, Результат);

КонецПроцедуры

&ТочкаМаршрута("snapshot")
&НеВыводитОтображениеКонтроллера
Процедура Снимок(Запрос, Ответ) Экспорт

	Если Не Авторизован(Запрос, Ответ) Тогда
		Возврат;
	КонецЕсли;

	Окружение = ОкружениеЗапроса(Запрос, Неопределено);

	Если Не ХранилищеФлагов.ОкружениеСуществует(Окружение) Тогда
		ВернутьПроблему(Ответ, 404, СтрШаблон("Окружение %1 не найдено", Окружение));
		Возврат;
	КонецЕсли;

	Результат = Новый Соответствие();
	Результат.Вставить("environment", Окружение);
	Результат.Вставить("flags", ХранилищеФлагов.Снимок(Окружение));

	ВернутьJson(Ответ, 200, Результат);

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////

Функция Авторизован(Запрос, Ответ)

	Если СервисБезопасности.КлючSDKВерен(Запрос.Заголовки) Тогда
		Возврат Истина;
	КонецЕсли;

	Если СервисБезопасности.ПроверитьТокен(СервисБезопасности.ТокенЗапроса(Запрос))["валиден"] Тогда
		Возврат Истина;
	КонецЕсли;

	ВернутьПроблему(Ответ, 401, "Требуется ключ SDK в заголовке Authorization");

	Возврат Ложь;

КонецФункции

Функция ОкружениеЗапроса(Запрос, Знач Тело)

	ИзПараметров = Неопределено;

	Если Запрос.ПараметрыИменные <> Неопределено Тогда
		ИзПараметров = Запрос.ПараметрыИменные.Получить("env");
	КонецЕсли;

	Если ИзПараметров <> Неопределено И Не ПустаяСтрока(Строка(ИзПараметров)) Тогда
		Возврат Строка(ИзПараметров);
	КонецЕсли;

	ИзТела = Значение(Тело, "environment");

	Если ИзТела <> Неопределено И Не ПустаяСтрока(Строка(ИзТела)) Тогда
		Возврат Строка(ИзТела);
	КонецЕсли;

	Возврат Конфигурация.ОкружениеПоУмолчанию();

КонецФункции

Функция ТелоЗапроса(Запрос)

	Если ПустаяСтрока(Запрос.Тело) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Запрос.Тело);

	Попытка
		Результат = ПрочитатьJSON(Чтение, Истина);
	Исключение
		Чтение.Закрыть();
		Возврат Неопределено;
	КонецПопытки;

	Чтение.Закрыть();

	Возврат ?(ТипЗнч(Результат) = Тип("Соответствие"), Результат, Неопределено);

КонецФункции

Функция Значение(Знач Источник, Знач Имя, Знач ЗначениеПоУмолчанию = Неопределено)

	Если Источник = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Найденное = Источник.Получить(Имя);

	Возврат ?(Найденное = Неопределено, ЗначениеПоУмолчанию, Найденное);

КонецФункции

Процедура ВернутьJson(Ответ, Знач Код, Знач ЗначениеОтвета)

	Ответ.УстановитьСостояние(Код);
	Ответ.Заголовки["Content-Type"] = "application/json; charset=utf-8";

	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, ЗначениеОтвета);

	Ответ.ТелоТекст = Запись.Закрыть();

КонецПроцедуры

Процедура ВернутьПроблему(Ответ, Знач Код, Знач Детали)

	Сформированный = ProblemResponse.ПоСтатусу(Код, Детали);

	Ответ.УстановитьСостояние(Код);
	Ответ.Заголовки["Content-Type"] = HttpProblems.ТипСодержимого();
	Ответ.ТелоТекст = Сформированный.Тело;

КонецПроцедуры


