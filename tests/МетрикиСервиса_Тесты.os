#Использовать asserts
#Использовать prometheus
#Использовать ".."

// Объект создаётся без внедрённых зависимостей - проверяется в том числе
// поведение при недоступном хранилище.

////////////////////////////////////////////////////////////////////////////////
// Состояние

&Тест
&ОтображаемоеИмя("Сбор возвращает четыре индикатора состояния")
Процедура СборВозвращаетИндикаторы() Экспорт

	Семейства = Новый МетрикиСервиса().Collect();

	Имена = Новый Массив();
	Для Каждого Семейство Из Семейства Цикл
		Имена.Добавить(Семейство.Имя);
		Ожидаем.Что(Семейство.Тип).Равно("gauge");
		Ожидаем.Что(Семейство.Сэмплы.Количество()).Равно(1);
	КонецЦикла;

	Ожидаем.Что(Имена).Содержит("oneflag_flags");
	Ожидаем.Что(Имена).Содержит("oneflag_environments");
	Ожидаем.Что(Имена).Содержит("oneflag_stream_subscribers");
	Ожидаем.Что(Имена).Содержит("oneflag_audit_records");

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Недоступное хранилище даёт минус единицу, а не ноль")
Процедура НедоступноеХранилищеДаётМинусЕдиницу() Экспорт

	Значения = ЗначенияСемейств(Новый МетрикиСервиса().Collect());

	Ожидаем.Что(Значения["oneflag_flags"]).Равно(-1);
	Ожидаем.Что(Значения["oneflag_environments"]).Равно(-1);
	Ожидаем.Что(Значения["oneflag_audit_records"]).Равно(-1);

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Число подписчиков без брокера равно нулю")
Процедура ЧислоПодписчиковБезБрокераНоль() Экспорт

	Значения = ЗначенияСемейств(Новый МетрикиСервиса().Collect());

	Ожидаем.Что(Значения["oneflag_stream_subscribers"]).Равно(0);

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Собранные семейства сериализуются в текстовый формат Prometheus")
Процедура СемействаСериализуются() Экспорт

	Текст = Prometheus.СериализоватьВТекст(Новый МетрикиСервиса().Collect());

	Ожидаем.Что(СтрНайти(Текст, "# TYPE oneflag_flags gauge")).Больше(0);
	Ожидаем.Что(СтрНайти(Текст, "# HELP oneflag_environments")).Больше(0);

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Счётчики событий

&Тест
&ОтображаемоеИмя("Изменение флага увеличивает счётчик с лейблами окружения и события")
Процедура ИзменениеУвеличиваетСчётчик() Экспорт

	Метрики = Новый МетрикиСервиса();
	Метрики.УчестьИзменение("dev", "com.oneflag.flag.created");
	Метрики.УчестьИзменение("dev", "com.oneflag.flag.created");

	Текст = Prometheus.СериализоватьВТекст(Prometheus.СобратьМетрики());

	Ожидаем.Что(СтрНайти(Текст,
		"oneflag_flag_changes_total{environment=""dev"",event=""com.oneflag.flag.created""} 2")).Больше(0);

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Оценка флага учитывается с причиной решения")
Процедура ОценкаУчитываетсяСПричиной() Экспорт

	Метрики = Новый МетрикиСервиса();
	Метрики.УчестьОценку("prod", "TARGETING_MATCH");

	Текст = Prometheus.СериализоватьВТекст(Prometheus.СобратьМетрики());

	Ожидаем.Что(СтрНайти(Текст,
		"oneflag_flag_evaluations_total{environment=""prod"",reason=""TARGETING_MATCH""} 1")).Больше(0);

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////

Функция ЗначенияСемейств(Знач Семейства)

	Результат = Новый Соответствие();

	Для Каждого Семейство Из Семейства Цикл
		Результат.Вставить(Семейство.Имя, Семейство.Сэмплы[0].Значение);
	КонецЦикла;

	Возврат Результат;

КонецФункции
