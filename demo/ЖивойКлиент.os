// Демонстрация живого обновления флагов.
//
// Приложение подключается к OneFlag через стандартный API OpenFeature
// и в цикле печатает, что оно показало бы пользователю. Пока оно работает,
// переключите флаг в дашборде - вывод изменится на следующей же итерации,
// без перезапуска и без опроса сервера.
//
// Запуск:
//   oscript sdk/demo/ЖивойКлиент.os [адрес] [ключ] [окружение] [итераций]

#Использовать openfeature
#Использовать "../src"

Перем АдресСервера;
Перем КлючSDK;
Перем Окружение;
Перем Итераций;

Функция Аргумент(Знач Индекс, Знач ЗначениеПоУмолчанию)

	Если АргументыКоманднойСтроки.Количество() > Индекс Тогда
		Возврат АргументыКоманднойСтроки[Индекс];
	КонецЕсли;

	Возврат ЗначениеПоУмолчанию;

КонецФункции

Функция Пользователи()

	Результат = Новый Массив();
	Результат.Добавить("user-1");
	Результат.Добавить("user-42");
	Результат.Добавить("user-77");

	Возврат Результат;

КонецФункции

АдресСервера = Аргумент(0, "http://localhost:3333");
КлючSDK = Аргумент(1, "local-sdk-key");
Окружение = Аргумент(2, "dev");
Итераций = Число(Аргумент(3, "30"));

Провайдер = Новый OneFlagProvider(АдресСервера, КлючSDK, Окружение);
OpenFeature.УстановитьПровайдер(Провайдер);

Если Провайдер.Состояние() <> "READY" Тогда
	Сообщить("Не удалось получить конфигурацию: " + Провайдер.ПоследняяОшибка());
	Сообщить("Приложение продолжит работать на значениях по умолчанию.");
Иначе
	Сообщить(СтрШаблон("Подключено к %1, окружение %2, флагов получено: %3",
		АдресСервера, Окружение, Формат(Провайдер.КлючиФлагов().Количество(), "ЧГ=0; ЧН=0")));
КонецЕсли;

Сообщить("Переключайте флаг new-checkout в дашборде - вывод изменится сам.");
Сообщить("");

Клиент = OpenFeature.ПолучитьКлиента("демо");
ПредыдущаяСтрока = "";

Для Шаг = 1 По Итераций Цикл

	Части = Новый Массив();

	Для Каждого Пользователь Из Пользователи() Цикл

		Контекст = Новый EvaluationContext(Пользователь, Новый Структура("plan", "pro"));
		Детали = Клиент.ПолучитьЛогическоеСДеталями("new-checkout", Ложь, Контекст);

		Части.Добавить(СтрШаблон("%1: %2 (%3)",
			Пользователь,
			?(Детали.Значение, "новая корзина", "старая корзина"),
			НРег(Детали.Причина)));

	КонецЦикла;

	ТекущаяСтрока = СтрСоединить(Части, "   |   ");

	// Печатаем только изменения: так в консоли видно ровно момент,
	// когда переключение в дашборде долетело до приложения
	Если ТекущаяСтрока <> ПредыдущаяСтрока Тогда
		Сообщить(СтрШаблон("[%1] %2", Формат(ТекущаяУниверсальнаяДата(), "ДФ=HH:mm:ss"), ТекущаяСтрока));
		ПредыдущаяСтрока = ТекущаяСтрока;
	КонецЕсли;

	Приостановить(1000);

КонецЦикла;

Сообщить("");
Сообщить(СтрШаблон("Обновлений конфигурации получено: %1",
	Формат(Провайдер.ОбновленийПолучено, "ЧГ=0; ЧН=0")));

OpenFeature.Завершить();


