#Использовать jwt

&Пластилин Перем Конфигурация;

&Лог("oneflag")
Перем Лог;

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры

// Имя куки, в которой дашборд хранит токен.
Функция ИмяКукиТокена() Экспорт

	Возврат "oneflag_token";

КонецФункции

// Проверяет учётные данные и выдаёт токен.
//
// Параметры:
//   Логин  - Строка - имя пользователя.
//   Пароль - Строка - пароль.
//
// Возвращаемое значение:
//   Строка - токен либо пустая строка, если данные неверны.
//
Функция Войти(Знач Логин, Знач Пароль) Экспорт

	Если Не УчётныеДанныеВерны(Логин, Пароль) Тогда
		// Пароль в журнал не пишем.
		// Приведение к строке обязательно: незаполненное поле формы приходит
		// как Неопределено, а logos такой параметр не подставляет и оставляет %1
		Лог.Предупреждение("Неудачная попытка входа, логин %1", Строка(Логин));
		Возврат "";
	КонецЕсли;

	Лог.Информация("Вход в дашборд: %1", Логин);

	Нагрузка = Новый Соответствие();
	Нагрузка.Вставить("роль", "admin");

	Параметры = Новый Структура();
	Параметры.Вставить("Субъект", Логин);
	Параметры.Вставить("Издатель", "oneflag");
	Параметры.Вставить("Аудитория", "dashboard");
	Параметры.Вставить("ВремяЖизни", Конфигурация.СрокТокена());

	Возврат JWT.Подписать(Нагрузка, Конфигурация.СекретТокенов(), Параметры);

КонецФункции

// Проверяет токен дашборда.
//
// Параметры:
//   Токен - Строка - значение из куки.
//
// Возвращаемое значение:
//   Соответствие - поля валиден, пользователь, роль, кодОшибки.
//
Функция ПроверитьТокен(Знач Токен) Экспорт

	Параметры = Новый Структура();
	Параметры.Вставить("Издатель", "oneflag");
	Параметры.Вставить("Аудитория", "dashboard");

	Проверка = JWT.Проверить(Токен, Конфигурация.СекретТокенов(), Параметры);

	Результат = Новый Соответствие();
	Результат.Вставить("валиден", Проверка.Валиден);
	Результат.Вставить("кодОшибки", Проверка.КодОшибки);
	Результат.Вставить("пользователь", ?(Проверка.Валиден, Проверка.Утверждение("sub", ""), ""));
	Результат.Вставить("роль", ?(Проверка.Валиден, Проверка.Утверждение("роль", "viewer"), ""));

	Возврат Результат;

КонецФункции

// Проверяет ключ SDK из заголовка Authorization.
//
// Параметры:
//   Заголовки - Соответствие - заголовки запроса.
//
// Возвращаемое значение:
//   Булево - Истина, если ключ верен.
//
Функция КлючSDKВерен(Знач Заголовки) Экспорт

	Возврат СравнитьЗаПостоянноеВремя(ИзвлечьКлюч(Заголовки), Конфигурация.КлючSDK());

КонецФункции

// Извлекает токен дашборда из запроса.
//
// Сначала спрашиваем разобранные куки веб-сервера, а к заголовку Cookie
// обращаемся как к запасному пути - так функция работает и в тестах,
// где полноценного запроса нет.
//
// Параметры:
//   Запрос - ВходящийЗапрос - запрос целиком.
//
// Возвращаемое значение:
//   Строка - значение токена либо пустая строка.
//
Функция ТокенЗапроса(Знач Запрос) Экспорт

	Попытка
		Значение = Запрос.Куки.ПолучитьЗначениеПоИмени(ИмяКукиТокена());
		Если Значение <> Неопределено И Не ПустаяСтрока(Значение) Тогда
			Возврат Значение;
		КонецЕсли;
	Исключение
		// Куки могут быть не разобраны - используем заголовок
	КонецПопытки;

	Возврат ТокенИзЗаголовков(Запрос.Заголовки);

КонецФункции

// Извлекает токен из заголовка Cookie.
//
// Параметры:
//   Заголовки - Соответствие - заголовки запроса.
//
// Возвращаемое значение:
//   Строка - значение токена либо пустая строка.
//
Функция ТокенИзЗаголовков(Знач Заголовки) Экспорт

	Заголовок = ЗначениеЗаголовка(Заголовки, "Cookie");

	Для Каждого Пара Из СтрРазделить(Заголовок, ";", Ложь) Цикл

		Позиция = СтрНайти(Пара, "=");

		Если Позиция > 0 И СокрЛП(Лев(Пара, Позиция - 1)) = ИмяКукиТокена() Тогда
			Возврат СокрЛП(Сред(Пара, Позиция + 1));
		КонецЕсли;

	КонецЦикла;

	Возврат "";

КонецФункции

////////////////////////////////////////////////////////////////////////////////

Функция УчётныеДанныеВерны(Знач Логин, Знач Пароль)

	СовпалЛогин = СравнитьЗаПостоянноеВремя(Строка(Логин), Конфигурация.ЛогинАдминистратора());
	СовпалПароль = СравнитьЗаПостоянноеВремя(Строка(Пароль), Конфигурация.ПарольАдминистратора());

	Возврат СовпалЛогин И СовпалПароль;

КонецФункции

Функция ИзвлечьКлюч(Знач Заголовки)

	Значение = СокрЛП(ЗначениеЗаголовка(Заголовки, "Authorization"));

	Если НРег(Лев(Значение, 7)) = "bearer " Тогда
		Возврат СокрЛП(Сред(Значение, 8));
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Имена HTTP-заголовков регистронезависимы, а клиенты пишут их по-разному.
//
Функция ЗначениеЗаголовка(Знач Заголовки, Знач Имя)

	Если Заголовки = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Искомое = НРег(Имя);

	Для Каждого Заголовок Из Заголовки Цикл
		Если НРег(Строка(Заголовок.Ключ)) = Искомое Тогда
			Возврат Строка(Заголовок.Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Сравнение за постоянное время: длительность проверки не должна зависеть
// от того, на каком символе секрет перестал совпадать.
//
Функция СравнитьЗаПостоянноеВремя(Знач Левое, Знач Правое)

	Если СтрДлина(Левое) <> СтрДлина(Правое) Тогда
		Возврат Ложь;
	КонецЕсли;

	Расхождение = 0;

	Для Позиция = 1 По СтрДлина(Левое) Цикл
		Расхождение = ПобитовоеИли(Расхождение,
			ПобитовоеИсключительноеИли(КодСимвола(Левое, Позиция), КодСимвола(Правое, Позиция)));
	КонецЦикла;

	Возврат Расхождение = 0;

КонецФункции
