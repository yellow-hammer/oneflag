// Соединение и keep-alive держит winow, поэтому в контроллере только
// регистрация топика.

&Пластилин Перем СервисСобытий;

Перем ИмяТопика;

&Контроллер("/")
Процедура ПриСозданииОбъекта(&Пластилин ТопикиСерверныхСобытий, &Пластилин Конфигурация)

	ИмяТопика = Конфигурация.ТопикПотока();

	ТопикиСерверныхСобытий.Добавить(ИмяТопика,
		Новый Действие(ЭтотОбъект, "ПриПодключении"),
		Новый Действие(ЭтотОбъект, "ПриОтключении"));

КонецПроцедуры

Процедура ПриПодключении(ИдентификаторСессии, ИдентификаторСоединения) Экспорт
КонецПроцедуры

Процедура ПриОтключении(ИдентификаторСессии, ИдентификаторСоединения) Экспорт
КонецПроцедуры

// Диагностика подписок: показывает, сколько клиентов слушают поток.
// Точка маршрута нужна и технически - winow требует хотя бы одну на контроллер.
//
&ТочкаМаршрута("stream/info")
&НеВыводитОтображениеКонтроллера
Процедура СведенияОПотоке(Ответ) Экспорт

	Сведения = Новый Соответствие();
	Сведения.Вставить("topic", ИмяТопика);
	Сведения.Вставить("subscribers", СервисСобытий.КоличествоПодписчиков());

	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, Сведения);

	Ответ.УстановитьСостояние(200);
	Ответ.Заголовки["Content-Type"] = "application/json; charset=utf-8";
	Ответ.ТелоТекст = Запись.Закрыть();

КонецПроцедуры
