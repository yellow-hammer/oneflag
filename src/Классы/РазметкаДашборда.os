#Использовать winow-view

Перем Рендерер;

&Желудь
Процедура ПриСозданииОбъекта()

	Параметры = Новый Структура();
	Параметры.Вставить("Макет", "макет");

	// От файла класса, а не от текущего каталога: команды CLI запускают откуда угодно
	КаталогШаблонов = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "templates");

	Рендерер = Новый ViewRenderer(КаталогШаблонов, Параметры);

КонецПроцедуры

// Полная страница дашборда.
//
// Параметры:
//   Окружение    - Строка - выбранное окружение.
//   Окружения    - Массив - доступные окружения.
//   Флаги        - Массив - флаги с настройками.
//   Пользователь - Строка - имя вошедшего пользователя.
//
// Возвращаемое значение:
//   Строка - HTML страницы.
//
Функция Страница(Знач Окружение, Знач Окружения, Знач Флаги, Знач Пользователь) Экспорт

	Модель = Новый Структура();
	Модель.Вставить("Окружение", Строка(Окружение));
	Модель.Вставить("Окружения", КлючиОкружений(Окружения));
	Модель.Вставить("Пользователь", Строка(Пользователь));
	Модель.Вставить("ТаблицаФлагов", ТаблицаФлагов(Окружение, Флаги));

	Возврат Рендерер.Страница("дашборд", Модель);

КонецФункции

// Таблица флагов - она же htmx-фрагмент, который заменяется при изменениях.
//
// Параметры:
//   Окружение - Строка - выбранное окружение.
//   Флаги     - Массив - флаги с настройками.
//
// Возвращаемое значение:
//   Строка - HTML фрагмента.
//
Функция ТаблицаФлагов(Знач Окружение, Знач Флаги) Экспорт

	Строки = Новый Массив();

	Для Каждого Флаг Из Флаги Цикл
		Строки.Добавить(СтрокаФлага(Окружение, Флаг));
	КонецЦикла;

	Возврат Рендерер.Фрагмент("таблица-флагов", Новый Структура("Строки", Строки));

КонецФункции

// Одна строка таблицы - минимальный фрагмент, который htmx подменяет
// после переключения тумблера.
//
// Параметры:
//   Окружение - Строка - выбранное окружение.
//   Флаг      - Соответствие - флаг с настройкой.
//
// Возвращаемое значение:
//   Строка - HTML строки таблицы.
//
Функция СтрокаФлага(Знач Окружение, Знач Флаг) Экспорт

	Настройка = Флаг["настройка"];
	Ключ = Строка(Флаг["ключ"]);

	Модель = Новый Структура();
	Модель.Вставить("Ключ", Ключ);
	Модель.Вставить("Имя", Строка(Флаг["имя"]));
	Модель.Вставить("Тип", Строка(Флаг["тип"]));
	Модель.Вставить("Включен", Настройка["включен"] = Истина);
	Модель.Вставить("Процент", Формат(Число(Настройка["процентВыкатки"]), "ЧГ=0; ЧН=0"));
	Модель.Вставить("АдресПереключения", СтрШаблон("/ui/flags/%1/toggle?env=%2", Ключ, Окружение));
	Модель.Вставить("АдресВыкатки", СтрШаблон("/ui/flags/%1/rollout?env=%2", Ключ, Окружение));

	Возврат Рендерер.Фрагмент("строка-флага", Модель);

КонецФункции

// Страница входа. Рисуется без общего макета.
//
// Параметры:
//   Ошибка - Строка - текст ошибки предыдущей попытки.
//
// Возвращаемое значение:
//   Строка - HTML страницы.
//
Функция СтраницаВхода(Знач Ошибка = "") Экспорт

	Возврат Рендерер.Отрендерить("вход", Новый Структура("Ошибка", Строка(Ошибка)));

КонецФункции

////////////////////////////////////////////////////////////////////////////////

Функция КлючиОкружений(Знач Окружения)

	Результат = Новый Массив();

	Для Каждого Запись Из Окружения Цикл
		Результат.Добавить(Строка(Запись["ключ"]));
	КонецЦикла;

	Возврат Результат;

КонецФункции
